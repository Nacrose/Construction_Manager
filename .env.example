# ============================================================================
# Construction Manager — environment template
# Copy to `.env` and fill in real values. Secrets are NEVER committed.
# ============================================================================

# ---- Database (PostgreSQL) ------------------------------------------------
# Local dev:
DATABASE_URL="postgresql://user:password@localhost:5432/construction_manager"
# Production (e.g. Neon): postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ---- Auth / Security ------------------------------------------------------
# 32+ char random string. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"
# Used by POST /api/setup and seed scripts
SETUP_SECRET="change-me-to-a-strong-setup-secret"

# ---- Platform Superadmin (Vercel / Production Provisioning) ----------------
# When deploying to Vercel, setting these environment variables will automatically
# provision the platform superadmin on first launch with zero manual setup.
SUPERADMIN_NAME="Platform Administrator"
SUPERADMIN_EMAIL="admin@construction.com"
SUPERADMIN_PASSWORD="YourStrongPassword123!"

# ---- File Storage ---------------------------------------------------------
# Provider: "local" (default, writes to ./uploads — PRIVATE dir, files are
#           served ONLY through the authenticated /api/files/[key] route) |
#           "s3" (S3-compatible, bucket can stay fully private) |
#           "vercel-blob" (routed through /api/files/[key]; the underlying
#            blob is public-access by SDK limitation — prefer s3/local for
#            strict privacy)
STORAGE_PROVIDER="local"

# ---- Cloudflare R2 (S3-compatible) ----------------------------------------
# Free tier: 10 GB storage, zero egress. To use R2, set STORAGE_PROVIDER=s3
# and fill the values below (find them in the R2 dashboard > bucket > keys).
# Keep the bucket PRIVATE — files are streamed server-side via
# /api/files/[key] with session + tenant checks; no public access needed.
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_ACCESS_KEY="<r2-access-key-id>"
# STORAGE_SECRET_KEY="<r2-secret-access-key>"
# STORAGE_BUCKET="construction-manager"

# ---- Email (SMTP, optional — used for notifications) ----------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@example.com"

# ---- Web Push (optional — browser notifications) --------------------------
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@example.com"

# ---- Error Tracking (Sentry, optional — unset = SDK inert) ----------------
# All values optional: with no DSN the SDK no-ops and the CSP stays at its
# strictest. GlitchTip (self-hosted, same protocol) works by pointing the
# DSNs at your GlitchTip instance. See docs/plans/sentry-integration.md.
# SENTRY_DSN=""                       # server DSN from project settings
# NEXT_PUBLIC_SENTRY_DSN=""           # same value, exposed to the browser
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""                   # git SHA — set by CI, not by hand
# NEXT_PUBLIC_SENTRY_RELEASE=""
# NEXT_PUBLIC_SENTRY_CSP_INGEST=""    # e.g. https://abc123.ingest.sentry.io —
#                                     # widens CSP connect-src for the browser
#                                     # SDK ONLY when Sentry is enabled
# SENTRY_AUTH_TOKEN=""                # CI only — source-map upload
# SENTRY_ORG=""
# SENTRY_PROJECT=""
