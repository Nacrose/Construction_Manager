    "zod": "^4.5.4",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24",
