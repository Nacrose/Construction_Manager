    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "bun-types": "^1.3.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@univerjs/core": {
      "nanoid": "5.1.16"
    }
  }
}
