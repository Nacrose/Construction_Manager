// ═══════════════════════════════════════════════════════════════
// FINANCIAL ARCHITECTURE — Journal Entry Foundation (Arch B)
// ═══════════════════════════════════════════════════════════════
// Double-entry bookkeeping layer. Every financial event (payment,
// bill, IPC, expense) generates a balanced journal entry with at
// least 2 lines (debit + credit). This enables:
//   - Trial balance derived from journal entries (not ad-hoc queries)
//   - P&L and Balance Sheet generation
//   - Tally/Swastik export
//   - Audit trail for every financial movement

// Registry of every file written by the storage abstraction (src/lib/storage.ts).
// Maps an opaque storage key -> owning org/project so /api/files/[key] can
// enforce tenant isolation before streaming bytes. WITHOUT this registry,
// uploaded files are served as unauthenticated static assets (C-4).
model StoredFile {
  id             String   @id @default(cuid())
  key            String   @unique // <epochMs>-<16 hex chars>.<ext>
  organizationId String // owning tenant
  projectId      String? // set when the file belongs to a specific project
  fileName       String? // original client filename (Content-Disposition)
  mimeType       String
  size           Int?
  externalUrl    String? // provider URL when not reconstructable (e.g. Vercel Blob)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model JournalEntry {
  id              String   @id @default(cuid())
  entryNumber     String   @unique // e.g. JE-2026-0001
  entryDate       DateTime @default(now())
  miti            String?  // BS date
  fiscalYearId    String?  // links to FiscalYearLock
  organizationId  String?  // owning org (org-level entries have projectId=null lines; this is the ONLY reliable org scope)
  source          String   // payment | vendor_bill | subcontractor_bill | ipc | site_expense | payroll | bank_charge | journal_voucher
  sourceRefId     String?  // the record ID that generated this entry
  sourceRefType   String?  // model name for reverse lookup
  description     String
  totalDebit Decimal @db.Decimal(15, 2) @default(0) // must equal totalCredit
  totalCredit Decimal @db.Decimal(15, 2) @default(0) // must equal totalDebit
  isPosted        Boolean  @default(false) // draft vs posted
  postedById      String?
  postedAt        DateTime?
  reversalOfId    String?  // if this entry reverses another
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           JournalEntryLine[]

  @@index([entryDate])
  @@index([source, sourceRefId])
  @@index([fiscalYearId])
  @@index([isPosted])
  @@index([organizationId])
}

model JournalEntryLine {
  id              String   @id @default(cuid())
  journalEntryId  String
  lineNumber      Int
  accountCode     String   // e.g. "1001", "2001", "4001"
  accountName     String   // denormalized for readability
  debit Decimal @db.Decimal(15, 2) @default(0)
  credit Decimal @db.Decimal(15, 2) @default(0)
  description     String?
  projectId       String?  // for project-level cost allocation
  partnerId       String?  // for vendor/subcontractor tracking
  createdAt       DateTime @default(now())

  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountCode])
  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════
// FINANCIAL ARCHITECTURE — Fiscal Year Locking (Arch A)
// ═══════════════════════════════════════════════════════════════
// Once a fiscal year is locked, all financial records in that period
// become read-only. This prevents retrospective editing after tax
// returns have been filed.

model FiscalYearLock {
  id              String   @id @default(cuid())
  organizationId  String
  fiscalYear      String   // e.g. "2081/82" (BS) or "2026" (AD)
  startDate       DateTime
  endDate         DateTime
  isLocked        Boolean  @default(false)
  lockedById      String?
  lockedAt        DateTime?
  lockNotes       String?  // e.g. "Locked after annual tax return filing"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, fiscalYear])
  @@index([organizationId, isLocked])
}

// ═══════════════════════════════════════════════════════════════
// FINANCIAL ARCHITECTURE — Report Snapshot (Arch D)
// ═══════════════════════════════════════════════════════════════
// Snapshots financial report results at a point in time so the
// user can see what the report showed even if underlying data
// changes later. Critical for audit defense.

model ReportSnapshot {
  id              String   @id @default(cuid())
  organizationId  String?
  projectId       String?
  reportType      String   // pnl | trial_balance | cash_flow | retention_ledger | tds_reconciliation
  reportDate      DateTime @default(now())
  generatedById   String
  snapshotData    String   // JSON stringified full report result
  periodLabel     String?  // e.g. "Fiscal Year 2081/82" or "2026-08"
  createdAt       DateTime @default(now())

  @@index([organizationId, reportType])
  @@index([projectId, reportType])
  @@index([reportDate])
}

// ═══════════════════════════════════════════════════════════════
// STANDARD COST CODING (Tier 3.13)
// ═══════════════════════════════════════════════════════════════
// Standard cost code system for cross-project cost comparison.
// Based on Nepal construction industry standard coding (similar to
// CPWD schedule). Each code has a parent for hierarchical reporting.

model CostCode {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "1.1", "2.3.1"
  name            String   // e.g. "Earthwork", "Concrete - PCC"
  nameNp          String?  // Devanagari name
  category        String   // material | labor | equipment | subcontract | overhead | revenue | asset | liability | equity
  parentId        String?  // for hierarchy
  level           Int      @default(1) // 1 = top-level, 2 = sub, 3 = detail
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  isSystem        Boolean  @default(false) // true = seeded standard codes (non-deletable)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent          CostCode?  @relation("CostCodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        CostCode[] @relation("CostCodeHierarchy")

  @@index([category])
  @@index([parentId])
  @@index([sortOrder])
}

// ═══════════════════════════════════════════════════════════════
// BANK RECONCILIATION — Persisted reconciliation state
// ═══════════════════════════════════════════════════════════════
// Stores the result of a bank reconciliation run so the user can
// review past reconciliations, see which entries were matched/unmatched,
// and track reconciliation history.

model BankReconciliation {
  id                    String   @id @default(cuid())
  bankAccountId         String
  periodStart          DateTime
  periodEnd             DateTime
  statementClosingBalance Decimal @db.Decimal(15, 2) @default(0)
  recordedBalance Decimal @db.Decimal(15, 2) @default(0)
  adjustedBalance Decimal @db.Decimal(15, 2) @default(0)
  matchedCount         Int      @default(0)
  unmatchedStatementCount Int    @default(0)
  unmatchedPaymentCount Int      @default(0)
  outstandingPayments Decimal @db.Decimal(15, 2) @default(0)
  unmatchedDeposits Decimal @db.Decimal(15, 2) @default(0)
  isReconciled         Boolean  @default(false)
  reconciliationData    String   // JSON: full matched/unmatched detail
  status               String   @default("draft") // draft | confirmed | discarded
  confirmedById         String?
  confirmedAt           DateTime?
  notes                 String?
  createdAt             DateTime @default(now())

  bankAccount           CompanyBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, periodStart])
  @@index([status])
}



// ─── Platform-level tables (no tenant scoping — see rls-tracker.json) ────────

/**
 * Admin-editable Nepal public holidays.
 *
 * The compiled fallback constant lives in src/server/utils/nepal-calendar.ts
 * (approximate lunar-calendar dates, 2025-2026 only). Rows in THIS table are
 * authoritative for any year they cover: when at least one row exists for a
 * year, the constant is ignored for that year (so wrong approximate dates can
 * be corrected or removed, not just supplemented). Years with no rows fall
 * back to the constant.
 *
 * Seeded from the constant (plus approximate 2027) by migration
 * 20260830080000_holiday_loginattempt. Managed via admin router procedures.
 */
model Holiday {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  name      String
  type      String   @default("public") // public | festival | optional
  createdAt DateTime @default(now())
}

/**
 * Durable login attempt log backing the rate limiter
 * (src/lib/login-rate-limit.ts).
 *
 * The previous in-memory limiter reset on every serverless cold start and
 * never shared state across instances. This table is the source of truth:
 * N failed attempts per email (or M per IP) inside the window blocks the
 * next attempt regardless of which instance serves it.
 *
 * Platform-level (no organizationId) — like Session/User. Rows older than
 * 24h are pruned opportunistically.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Inter-Site Resource & Machinery Transfer Models
// ─────────────────────────────────────────────────────────────

model InterSiteTransfer {
  id                          String   @id @default(cuid())
  transferNo                  String   // e.g. "ITC-2081-001"
  organizationId              String
  originProjectId             String
  destinationProjectId        String
  materialId                  String
  quantity                    Decimal  @db.Decimal(15, 4)
  unit                        String
  transferRate                Decimal  @db.Decimal(15, 4) @default(0)
  totalAmount                 Decimal  @db.Decimal(15, 2) @default(0)
  originStoreLocationId       String?
  destinationStoreLocationId  String?
  isInstantTransfer           Boolean  @default(true) // true = 1-click direct move; false = 2-step in-transit
  status                      String   @default("received") // "dispatched" | "in_transit" | "received" | "cancelled"
  dispatchDate                DateTime @default(now())
  dispatchMiti                String?
  dispatchedById              String?
  vehicleNo                   String?
  driverName                  String?
  chalanNo                    String?
  receivedDate                DateTime?
  receivedMiti                String?
  receivedById                String?
  receivedQty                 Decimal? @db.Decimal(15, 4)
  damageLossQty               Decimal? @db.Decimal(15, 4) @default(0)
  remarks                     String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization                Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  originProject               Project        @relation("OriginProjectTransfers", fields: [originProjectId], references: [id], onDelete: Cascade)
  destinationProject          Project        @relation("DestinationProjectTransfers", fields: [destinationProjectId], references: [id], onDelete: Cascade)
  material                    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  originStoreLocation         StoreLocation? @relation("OriginStoreInterSiteTransfers", fields: [originStoreLocationId], references: [id], onDelete: SetNull)
  destinationStoreLocation    StoreLocation? @relation("DestinationStoreInterSiteTransfers", fields: [destinationStoreLocationId], references: [id], onDelete: SetNull)
  dispatchedBy                User?          @relation("DispatchedByUser", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy                  User?          @relation("ReceivedByUser", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([originProjectId])
  @@index([destinationProjectId])
  @@index([materialId])
  @@index([status])
}

model EquipmentTransfer {
  id                   String   @id @default(cuid())
  transferNo           String   // e.g. "ETC-2081-001"
  organizationId       String
  equipmentId          String
  originProjectId      String
  destinationProjectId String
  transferDate         DateTime @default(now())
  transferMiti         String?
  chalanNo             String?
  vehicleNo            String?  // Transporter truck / trailer number
  driverName           String?
  transporterName      String?
  meterAtDispatch      Decimal? @db.Decimal(15, 2)
  meterAtReceive       Decimal? @db.Decimal(15, 2)
  freightCost          Decimal? @db.Decimal(15, 2) @default(0)
  status               String   @default("completed") // "in_transit" | "completed" | "cancelled"
  dispatchedById       String?
  receivedById         String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment            Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  originProject        Project      @relation("OriginEquipmentTransfers", fields: [originProjectId], references: [id], onDelete: Cascade)
  destinationProject   Project      @relation("DestinationEquipmentTransfers", fields: [destinationProjectId], references: [id], onDelete: Cascade)
  dispatchedBy         User?        @relation("DispatchedEquipmentByUser", fields: [dispatchedById], references: [id], onDelete: SetNull)
  receivedBy           User?        @relation("ReceivedEquipmentByUser", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([equipmentId])
  @@index([originProjectId])
  @@index([destinationProjectId])
  @@index([status])
}

