// Construction Manager — Prisma schema (PostgreSQL)
// Real relational schema — deployed on Vercel Postgres (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Notifications (in-app bell)
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  type      String // schedule_delay | conflict_detected | revision_submitted | revision_approved | revision_rejected | task_starting
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  String? // JSON string with extra context
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Organizations (Multi-tenancy)
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  logoUrl   String?
  status    String   @default("active") // active | archived
  // Setup Wizard & Operating Model Fields
  orgScale        String   @default("multi_project") // "single_project_jv" | "multi_project"
  partnershipType String   @default("sole")          // "sole" | "lead_partner_jv" | "joint_jv"
  financeLocation String   @default("centralized")   // "centralized" | "site_autonomous" | "imprest_only"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Operating Model & Financial Delegation ───────────
  // Controls how finance/procurement authority is distributed
  // between HQ and site teams.
  operatingModel     String  @default("decentralized_site_and_hq")
  // "hq_centralized_imprest"   — HQ does all finance/procurement; site logs petty cash only
  // "hybrid_daybook_hq_procure" — Site + HQ both log Day Book; HQ manages bulk procurement
  // "decentralized_site_and_hq" — Site PMs have full local authority (default)
  // "single_project_jv"        — JV SPV mode (Phase 3 — not yet implemented)

  sitePettyCashLimit Decimal @db.Decimal(15, 2) @default(25000.0)
  // Maximum single voucher amount a Site Engineer can create without HQ approval.
  // Only enforced when operatingModel = "hq_centralized_imprest".

  users                User[]
  projects             Project[]
  reportTemplates      ReportTemplate[]
  rateProfiles         RateProfile[]
  rateCatalogs         RateBook[]
  uncatalogedMaterials UncatalogedMaterial[]
  presetAnalyses       GlobalPresetAnalysis[]
  ganttTemplates       GanttTaskTemplate[]
  companyBankAccounts  CompanyBankAccount[]
  headOfficeExpenses   HeadOfficeExpense[]
  bankGuarantees       BankGuarantee[]
  delegationRules      DelegationRule[]
  interSiteTransfers   InterSiteTransfer[]
  equipmentTransfers   EquipmentTransfer[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Delegation Rules — configurable per-org financial action permissions
// ─────────────────────────────────────────────────────────────

model DelegationRule {
  id              String   @id @default(cuid())
  organizationId  String
  action          String   // e.g. "create_payment", "create_vendor_bill", "create_po", "create_site_expense"
  maxAmount Decimal? @db.Decimal(15, 2) // null = unlimited; 0 = blocked entirely
  allowedRoles    String   @default("[]") // JSON array: ["project_manager","coordinator","engineer"]
  siteScopedOnly   Boolean  @default(false) // true = only site-level roles (engineer), not HQ
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, action])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────
// Org Material Entry — org-level adoptions & custom materials (Admin)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Material Catalog — canonical material names (global + org legacy/bridge)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Rate Catalogs — fiscal-year rate tables (e.g. District Rates 2080/81)
// ─────────────────────────────────────────────────────────────

model RateBook {
  id              String    @id @default(cuid())
  organizationId  String? // null = global
  projectId       String? // null = not project-scoped
  name            String
  fiscalYear      String // "2080/81"
  scope           String    @default("org") // "global" | "org" | "project"
  sourceCatalogId String? // which global/org catalog it was imported from
  districts       String[] // ["Morang", "Sunsari", "Kathmandu", ...]
  isActive        Boolean   @default(false)
  isBaseline      Boolean   @default(true)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogRates RateEntry[]   @relation("RateBookEntries")

  @@index([organizationId])
  @@index([projectId])
  @@map("RateCatalog")
}

// DEPRECATED: Use CatalogRate (v2) instead. RateCatalogItem + RateCatalogItemRate
// are kept for backwards compatibility during migration.

// DEPRECATED: Use CatalogRate (v2) instead. ProjectRateColumn/Entry kept for backwards compat.

// ─────────────────────────────────────────────────────────────
// Org Rate Catalog & Overrides (Inheritance model)
// DEPRECATED: Org rate catalog inheritance. Use CatalogRate (v2) with scope="org" instead.
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Uncataloged Materials — governance review queue (Org & Global)
// ─────────────────────────────────────────────────────────────

model UncatalogedMaterial {
  id                  String   @id @default(cuid())
  level               String // "org" | "global"
  organizationId      String?
  rawName             String
  normalizedName      String
  unit                String?
  category            String?
  sourceType          String // "boq_ingredient" | "gate_entry" | "purchase_order" | "manual"
  sourceProjectId     String?
  occurrenceCount     Int      @default(1)
  status              String   @default("pending") // "pending" | "mapped" | "promoted" | "ignored"
  mappedToId          String?
  suggestedMatchId    String?
  suggestedMatchScore Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([level, status])
  @@index([normalizedName])
}

// ─────────────────────────────────────────────────────────────
// Material Merge Audit Log
// ─────────────────────────────────────────────────────────────

model MaterialMergeLog {
  id                String    @id @default(cuid())
  level             String // "global" | "org" | "project"
  winnerId          String
  loserId           String
  mergedById        String
  mergedAt          DateTime  @default(now())
  affectedTables    String[]
  totalRowsRemapped Int
  notes             String?
  isRolledBack      Boolean   @default(false)
  rolledBackAt      DateTime?
  rolledBackById    String?

  mergedBy User @relation(fields: [mergedById], references: [id], onDelete: Cascade)

  @@index([winnerId])
  @@index([loserId])
}

// ─────────────────────────────────────────────────────────────
// Rate Fiscal Year Audit — DoR rate change history
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Market Rate Revision Log & Entries (Project cost-side audit)
// ─────────────────────────────────────────────────────────────

model MarketRateRevisionLog {
  id              String   @id @default(cuid())
  projectId       String
  revisionType    String // "fiscal_year_switch" | "manual_market_rate" | "org_catalog_update"
  fromFiscalYear  String?
  toFiscalYear    String?
  effectiveDate   DateTime @default(now())
  loggedAt        DateTime @default(now())
  loggedById      String
  totalCostImpact Decimal @db.Decimal(15, 2) @default(0)
  notes           String?

  project  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  loggedBy User                      @relation(fields: [loggedById], references: [id], onDelete: Cascade)
  entries  MarketRateRevisionEntry[]

  @@index([projectId, loggedAt])
}

model MarketRateRevisionEntry {
  id                    String @id @default(cuid())
  revisionLogId         String
  materialName          String
  district              String
  oldMarketRate Decimal @db.Decimal(15, 4)
  newMarketRate Decimal @db.Decimal(15, 4)
  rateDelta Decimal @db.Decimal(15, 4)
  estimatedRemainingQty Decimal @db.Decimal(15, 4) @default(0)
  costImpact Decimal @db.Decimal(15, 2) @default(0)

  revisionLog MarketRateRevisionLog @relation(fields: [revisionLogId], references: [id], onDelete: Cascade)

  @@index([revisionLogId])
}

// ─────────────────────────────────────────────────────────────
// Unrecognized Materials — legacy bridge
// ─────────────────────────────────────────────────────────────

// Feature flags — enable/disable features globally or per org
model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique // e.g. "pwa", "voice_messages", "push_notifications"
  description     String?
  enabledGlobally Boolean  @default(true)
  orgOverrides    String? // JSON: { "orgId": false, "orgId2": true }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([key])
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum LibraryPurpose {
  client_estimate
  contractor_bid
  contractor_actual
}

enum BoqVersionStatus {
  draft
  approved
}

enum VersionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// Auth & users
// ─────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              String    @default("engineer") // project_manager | engineer | coordinator | client | inspector
  avatarUrl         String?
  organizationId    String? // null = not yet assigned to an org
  orgRole           String    @default("member") // org_admin | member
  isSuperAdmin      Boolean   @default(false) // platform operator (cross-org)
  lastActiveAt      DateTime? // last time the user hit any API endpoint (presence)
  deactivatedAt     DateTime? // null = active; set when admin deactivates
  deactivatedReason String?
  preferences       Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization         Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions             Session[]
  pushSubscriptions    PushSubscription[]
  memberships          ProjectMember[]
  createdProjects      Project[]               @relation("ProjectCreatedBy")
  rfis                 Rfi[]                   @relation("RfiCreatedBy")
  rfiResponses         RfiResponse[]
  rfiComments          RfiComment[]
  dailyReports         DailyReport[]           @relation("ReportCreatedBy")
  materialTransactions MaterialTransaction[]
  auditLogs            AuditLog[]
  approvedVersions     GanttVersion[]          @relation("ApprovedBy")
  notifications        Notification[]
  reportTemplates      ReportTemplate[]        @relation("ReportTemplateOwner")
  approvedDocuments    ApprovedDocument[]      @relation("ApprovedDocUploadedBy")
  projectCosts         ProjectCost[]           @relation("ProjectCostCreatedBy")
  chatMemberships      ChatMember[]            @relation("ChatMemberUser")
  chatMessages         ChatMessage[]           @relation("ChatMessageUser")
  chatReadReceipts     ChatReadReceipt[]       @relation("ChatReadReceiptUser")
  requisitionsCreated  PurchaseRequisition[]   @relation("RequisitionCreatedBy")
  requisitionsApproved PurchaseRequisition[]   @relation("RequisitionApprovedBy")
  vendorPayments       VendorPayment[]
  materialMergeLogs    MaterialMergeLog[]
  marketRateRevisions  MarketRateRevisionLog[]
  ganttTemplates       GanttTaskTemplate[]
  leaveApprovedBy      LeaveRequest[]          @relation("LeaveApprovedBy")
  leaveCreatedBy       LeaveRequest[]          @relation("LeaveCreatedBy")
  expensesApprovedBy   SiteExpense[]           @relation("ExpenseApprovedBy")
  expensesCreatedBy            SiteExpense[]           @relation("ExpenseCreatedBy")
  subBillsCreatedBy            SubcontractorBill[]     @relation("SubBillCreatedBy")
  dispatchedTransfers          InterSiteTransfer[]     @relation("DispatchedByUser")
  receivedTransfers            InterSiteTransfer[]     @relation("ReceivedByUser")
  dispatchedEquipmentTransfers EquipmentTransfer[]     @relation("DispatchedEquipmentByUser")
  receivedEquipmentTransfers   EquipmentTransfer[]     @relation("ReceivedEquipmentByUser")

  @@index([email])
  @@index([organizationId])
}

model Session {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token              String    @unique // JWT id (jti)
  kind               String    @default("user") // "user" | "admin" — admin sessions are short-lived & platform-only
  impersonatedOrgId  String? // when a superadmin is acting inside a tenant org
  impersonatedAt     DateTime?
  impersonatedReason String?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([kind])
  @@index([impersonatedOrgId])
}

// Push notification subscriptions (one user can have multiple devices)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique // browser push service endpoint URL
  p256dh    String // public key
  auth      String // auth secret
  userAgent String? // for identifying the device/browser
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Projects & membership
// ─────────────────────────────────────────────────────────────

model Project {
  id                 String    @id @default(cuid())
  name               String
  code               String
  client             String?
  location           String?
  contractValue Decimal? @db.Decimal(15, 2)
  startDate          DateTime?
  endDate            DateTime?
  status             String    @default("active") // active | on_hold | completed | archived
  description        String?
  createdById        String
  organizationId     String? // null = legacy project (pre-multi-tenancy)
  createdAt          DateTime  @default(now())
  boqLocked          Boolean   @default(false)
  // Configurable cost rates per project
  skilledWageRate Decimal? @db.Decimal(15, 4) // NPR/day for skilled workers
  unskilledWageRate Decimal? @db.Decimal(15, 4) // NPR/day for unskilled workers
  supervisorWageRate Decimal? @db.Decimal(15, 4) // NPR/day for supervisors
  ownedEquipRate Decimal? @db.Decimal(15, 4) // NPR/hr for owned equipment
  hiredEquipRate Decimal? @db.Decimal(15, 4) // NPR/hr for hired equipment
  fuelPricePerLiter Decimal? @db.Decimal(15, 2) // NPR/liter for diesel
  updatedAt          DateTime  @updatedAt

  // Default library for resource/cost calculations (Gantt, Procurement, Daily Program)
  costLibraryId String?
  costLibrary   AnalysisLibrary? @relation("ProjectCostLibrary", fields: [costLibraryId], references: [id], onDelete: SetNull)

  organization         Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy            User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  members              ProjectMember[]
  rfis                 Rfi[]
  dailyReports         DailyReport[]
  boqItems             BoqItem[]
  ganttTasks           GanttTask[]
  ganttVersions        GanttVersion[]
  materials            Material[]
  materialTransactions MaterialTransaction[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  equipment            Equipment[]
  equipmentLogs        EquipmentLog[]
  equipmentMaintenance EquipmentMaintenance[]
  documents            Document[]
  transmittals         Transmittal[]
  drawings             Drawing[]
  ipcs                 Ipc[]
  staff                Staff[]
  staffAttendance      StaffAttendance[]
  staffRoles           StaffRole[]
  dailyPrograms        DailyProgram[]
  rateProfiles         RateProfile[]
  analysisLibraries    AnalysisLibrary[]
  boqVersions          BoqVersion[]
  auditLogs            AuditLog[]
  gateEntries          GateEntry[]
  subcontractors       Subcontractor[]
  variationOrders      VariationOrder[]
  reportTemplates      ReportTemplate[]
  approvedDocuments    ApprovedDocument[]
  projectCosts         ProjectCost[]
  correspondences      Correspondence[]
  drawingSets          DrawingSet[]
  equipmentRentals     EquipmentRental[]
  equipmentVendors     EquipmentVendor[]
  equipmentSpotHires   EquipmentSpotHire[]
  submittals           Submittal[]
  punchItems           PunchItem[]
  chatChannels         ChatChannel[]
  payments             Payment[]
  safetyIncidents      SafetyIncident[]
  qualityInspections   QualityInspection[]
  meetings             Meeting[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  siteExpenses         SiteExpense[]
  subcontractorBills   SubcontractorBill[]
  staffAdvances        StaffAdvance[]
  payrollRuns          PayrollRun[]
  partners             Partner[]
  requisitions         PurchaseRequisition[]
  storeLocations       StoreLocation[]
  vendorBills          VendorBill[]
  vendorPayments       VendorPayment[]
  paymentCategories    PaymentCategory[]
  vatBills             VatBill[]
  rateBooks            RateBook[]
  activeFiscalYear     String?
  rateLockDate         DateTime?
  financeMode          String    @default("autonomous") // "lean" | "imprest_only" | "autonomous"
  enabledModules       Json      @default("{}")  // per-project module toggle map; missing key = enabled
  marketRateRevisions  MarketRateRevisionLog[]
  plants               Plant[]
  plantMixDesigns      PlantMixDesign[]
  plantBatchTickets    PlantBatchTicket[]
  plantDailyLogs       PlantDailyLog[]
  ganttTemplates       GanttTaskTemplate[]
  bankGuarantees               BankGuarantee[]
  jvAgreement                  JvPartnerAgreement?
  operationalPreset            String                  @default("record_keeper") // "record_keeper" | "lean" | "enterprise"
  outboundTransfers            InterSiteTransfer[]     @relation("OriginProjectTransfers")
  inboundTransfers             InterSiteTransfer[]     @relation("DestinationProjectTransfers")
  outboundEquipmentTransfers   EquipmentTransfer[]     @relation("OriginEquipmentTransfers")
  inboundEquipmentTransfers    EquipmentTransfer[]     @relation("DestinationEquipmentTransfers")

  @@unique([organizationId, code])
  @@index([status])
  @@index([createdById])
  @@index([organizationId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String // project_manager | engineer | coordinator | client | inspector
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  assignedRfis Rfi[] @relation("RfiAssignedTo")

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// RFI module (proof-of-concept for the new architecture)
// ─────────────────────────────────────────────────────────────

model Rfi {
  id                  String    @id @default(cuid())
  number              String // human-friendly, e.g. RFI-001, unique within project
  projectId           String
  createdById         String
  ganttTaskId         String? // linked Gantt task (optional)
  boqItemId           String? // linked BOQ item (optional)
  drawingId           String? // referenced drawing (optional)
  subcontractorId     String? // linked subcontractor (optional — if work is subbed out)
  subject             String
  description         String
  location            String? // working location (e.g. "Chainage 0+500", "Grid A-3", "North wing")
  status              String    @default("draft") // draft | submitted | approved | rejected | closed
  priority            String    @default("normal") // low | normal | high | urgent
  discipline          String? // civil | structural | electrical | mechanical | architectural
  workDate            DateTime?
  submittedAt         DateTime?
  respondedAt         DateTime?
  inspectionStartTime DateTime?
  inspectionEndTime   DateTime?
  pinX Decimal? @db.Decimal(15, 2) // x coordinate (0-1, percentage) on the linked drawing
  pinY Decimal? @db.Decimal(15, 2) // y coordinate (0-1, percentage) on the linked drawing
  costImpact          Boolean   @default(false)
  scheduleImpact      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("RfiCreatedBy", fields: [createdById], references: [id])
  ganttTask         GanttTask?         @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  boqItem           BoqItem?           @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  drawing           Drawing?           @relation(fields: [drawingId], references: [id], onDelete: SetNull)
  subcontractor     Subcontractor?     @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  assignedToId      String? // project member assigned to respond
  assignedTo        ProjectMember?     @relation("RfiAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  items             RfiItem[]
  attachments       RfiAttachment[]
  comments          RfiComment[]
  responses         RfiResponse[]
  dailyProgramTasks DailyProgramTask[]
  plantBatchTickets PlantBatchTicket[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([ganttTaskId])
  @@index([drawingId])
  @@index([assignedToId])
  @@index([subcontractorId])
}

model RfiItem {
  id          String   @id @default(cuid())
  rfiId       String
  boqItemId   String? // linked BOQ item (for material/resource derivation)
  boqCode     String? // denormalized for display
  boqDesc     String? // denormalized for display
  quantity Decimal? @db.Decimal(15, 4) // planned quantity for THIS RFI (portion of task total)
  unit        String?
  paymentType String   @default("payable") // payable | unpayable | temporary
  remark      String?
  rfi         Rfi      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  boqItem     BoqItem? @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@index([rfiId])
  @@index([boqItemId])
}

model RfiAttachment {
  id           String   @id @default(cuid())
  rfiId        String
  fileName     String
  fileType     String
  fileSize     Int
  storageUrl   String   @default("")
  data         String // base64-encoded file content (legacy, migrate to storageUrl)
  uploadedById String?
  createdAt    DateTime @default(now())
  rfi          Rfi      @relation(fields: [rfiId], references: [id], onDelete: Cascade)

  @@index([rfiId])
}

model RfiComment {
  id        String   @id @default(cuid())
  rfiId     String
  parentId  String? // null = top-level, non-null = reply to another comment
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rfi       Rfi      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([rfiId])
  @@index([parentId])
}

model RfiResponse {
  id          String   @id @default(cuid())
  rfiId       String
  responderId String
  response    String
  decision    String   @default("info") // info | approved | rejected | clarifications_requested
  createdAt   DateTime @default(now())
  rfi         Rfi      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  responder   User     @relation(fields: [responderId], references: [id])

  @@index([rfiId])
}

// ─────────────────────────────────────────────────────────────
// Daily Reports module
// ─────────────────────────────────────────────────────────────

model DailyReport {
  id                 String    @id @default(cuid())
  number             String
  projectId          String
  createdById        String
  reportDate         DateTime
  dayOfWeek          String?
  weatherMorning     String?
  weatherAfternoon   String?
  weatherEvening     String?
  maxTempC           Float?
  minTempC           Float?
  rainfallMm         Float?
  problems           String?
  safetyNotes        String?
  preparedById       String?
  checkedById        String?
  approvedById       String?
  preparedAt         DateTime?
  checkedAt          DateTime?
  approvedAt         DateTime?
  status             String    @default("draft")
  remarks            String?
  submittedAt        DateTime?
  submittedById      String?
  clientApprovedAt   DateTime?
  clientApprovedById String?
  clientApprovalNote String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                    @relation("ReportCreatedBy", fields: [createdById], references: [id])
  attachments DailyReportAttachment[]

  workforce        DailyReportWorkforce[]
  workProgress     DailyReportProgress[]
  equipmentUsed    DailyReportEquipment[]
  materialReceived DailyReportMaterial[]
  materialConsumed DailyReportMaterialConsumed[]
  siteVisits       DailyReportVisitor[]
  meetings         DailyReportMeeting[]

  @@unique([projectId, number])
  @@index([projectId, reportDate])
  @@index([projectId, status])
}

model DailyReportAttachment {
  id           String    @id @default(cuid())
  reportId     String
  fileName     String
  fileType     String
  fileSize     Int
  storageUrl   String    @default("")
  data         String // base64-encoded file content (legacy, migrate to storageUrl)
  uploadedById String
  latitude     Float?
  longitude    Float?
  takenAt      DateTime?
  uploadedAt   DateTime  @default(now())

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ─── Normalized Daily Report sub-models ──────────────────────

model DailyReportWorkforce {
  id        String  @id @default(cuid())
  reportId  String
  company   String
  trade     String
  skill     String
  headcount Int
  regHours Decimal @db.Decimal(15, 4)
  otHours Decimal @db.Decimal(15, 4)
  location  String?
  sortOrder Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportProgress {
  id              String  @id @default(cuid())
  reportId        String
  rfiId           String?
  rfiItemId       String?
  ganttTaskId     String?
  boqItemId       String?
  boqCode         String?
  boqDesc         String?
  taskDescription String?
  plannedQty Decimal @db.Decimal(15, 4) @default(0)
  actualQty Decimal @db.Decimal(15, 4) @default(0)
  batchedQty Decimal? @db.Decimal(15, 4) @default(0)
  payableQty Decimal? @db.Decimal(15, 4) @default(0)
  unit            String?
  paymentType     String  @default("payable")
  executionStatus String  @default("planned")
  delayReason     String?
  delayNotes      String?
  isEotCandidate  Boolean @default(false)
  location        String?
  remarks         String?
  sortOrder       Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportEquipment {
  id           String  @id @default(cuid())
  reportId     String
  equipmentId  String?
  name         String
  type         String
  ownership    String  @default("owned")
  workingHours Decimal @db.Decimal(15, 4) @default(0)
  fuel Decimal @db.Decimal(15, 2) @default(0)
  sortOrder    Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportMaterial {
  id         String  @id @default(cuid())
  reportId   String
  name       String
  qty Decimal @db.Decimal(15, 4) @default(0)
  unit       String?
  supplier   String?
  vehicle    String?
  testStatus String  @default("none")
  sortOrder  Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportMaterialConsumed {
  id         String  @id @default(cuid())
  reportId   String
  materialId String?
  name       String
  quantity Decimal @db.Decimal(15, 4) @default(0)
  unit       String?
  sortOrder  Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportVisitor {
  id           String  @id @default(cuid())
  reportId     String
  visitor      String
  organization String?
  purpose      String?
  time         String?
  notes        String?
  sortOrder    Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model DailyReportMeeting {
  id        String  @id @default(cuid())
  reportId  String
  topic     String
  attendees String?
  notes     String?
  sortOrder Int     @default(0)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ─────────────────────────────────────────────────────────────
// BOQ module
// ─────────────────────────────────────────────────────────────

model BoqItem {
  id          String @id @default(cuid())
  projectId   String
  code        String // e.g. 1.1.1
  description String
  unit        String // e.g. cum, sqm, no, m
  quantity Decimal @db.Decimal(15, 4) @default(0)
  rate Decimal @db.Decimal(15, 4) @default(0)
  amount Decimal @db.Decimal(15, 2) @default(0) // quantity * rate, denormalized for speed

  // Phase 3: Baseline tracking (Original Contract state)
  baselineQty Decimal? @db.Decimal(15, 4)
  baselineRate Decimal? @db.Decimal(15, 4)

  category  String? // e.g. "Civil", "Structural" (legacy, kept for compatibility)
  section   String? // e.g. "A) Provisional Items", "B) Civil Cost" (matches IPC format)
  tags      String? // JSON string array: ["priority", "revised", "pending"]
  sortOrder Int      @default(0)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ingredients       BoqIngredient[]
  rateAnalyses      RateAnalysis[]
  taskLinks         TaskBoqLink[]
  rfiItems          RfiItem[]
  rfis              Rfi[]
  variationItems    VariationOrderItem[]
  versionItems      BoqVersionItem[]
  dailyProgramTasks DailyProgramTask[]
  projectCosts      ProjectCost[]
  equipmentLogs     EquipmentLog[]
  equipmentSpotHires EquipmentSpotHire[]
  plantMixDesigns   PlantMixDesign[]

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
}

model BoqIngredient {
  id             String  @id @default(cuid())
  boqItemId      String
  rateAnalysisId String?
  name           String
  type           String // material | labor | equipment | overhead
  calcMode       String  @default("fixed") // fixed | percentage
  quantity Decimal @db.Decimal(15, 4) @default(0)
  unit           String  @default("")
  percentage Decimal @db.Decimal(15, 4) @default(0)
  pctBase        String  @default("")
  rate Decimal @db.Decimal(15, 4) @default(0)
  amount Decimal @db.Decimal(15, 2) @default(0)
  sortOrder      Int     @default(0)

  // Provenance: which RateProfileItem supplied this ingredient's rate
  rateProfileItemId String?

  // Procurement link: which Material this ingredient maps to
  materialId String?

  // Catalog provenance: which catalog entry + district + FY this rate came from
  rateDistrict      String?
  rateFiscalYear    String?
  catalogMaterialId String?

  boqItem         BoqItem          @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  rateAnalysis    RateAnalysis?    @relation(fields: [rateAnalysisId], references: [id], onDelete: Cascade)
  rateProfileItem RateProfileItem? @relation(fields: [rateProfileItemId], references: [id], onDelete: SetNull)
  material        Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  catalogMaterial CatalogMaterial? @relation(fields: [catalogMaterialId], references: [id], onDelete: SetNull)

  @@index([boqItemId])
  @@index([rateAnalysisId])
  @@index([rateProfileItemId])
  @@index([materialId])
  @@index([catalogMaterialId])
}

model RateAnalysis {
  id          String           @id @default(cuid())
  boqItemId   String
  libraryId   String?
  name        String           @default("Default")
  batchSize Decimal @db.Decimal(15, 2) @default(1)
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  boqItem     BoqItem          @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  library     AnalysisLibrary? @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  ingredients BoqIngredient[]

  @@index([boqItemId])
  @@index([libraryId])
}

model AnalysisLibrary {
  id                    String         @id @default(cuid())
  projectId             String
  name                  String // e.g. "Client's Estimate", "Contractor's Bid", "Contractor's Actual"
  purpose               LibraryPurpose @default(client_estimate)
  isDefault             Boolean        @default(false)
  districtRateCatalogId String?
  selectedFiscalYear    String?
  selectedDistrict      String?
  orgRateCatalogId      String?
  projectRateCatalogId  String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses              RateAnalysis[]
  projects              Project[]      @relation("ProjectCostLibrary")

  @@unique([projectId, purpose])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// BOQ Versioning — created when a Variation Order is approved
// V1 = original contract, V2 = after VO#1, V3 = after VO#2, etc.
// ─────────────────────────────────────────────────────────────

model BoqVersion {
  id               String           @id @default(cuid())
  projectId        String
  versionNumber    Int              @default(1)
  status           BoqVersionStatus @default(draft)
  variationOrderId String? // set when approved via VO
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variationOrder VariationOrder?  @relation(fields: [variationOrderId], references: [id], onDelete: SetNull)
  ipcs           Ipc[]
  items          BoqVersionItem[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model BoqVersionItem {
  id        String @id @default(cuid())
  versionId String
  boqItemId String // original BOQ item this version item refers to

  // Snapshot of the BOQ item at this version
  code        String
  description String
  unit        String
  quantity Decimal @db.Decimal(15, 4)
  rate Decimal @db.Decimal(15, 4)
  amount Decimal @db.Decimal(15, 2)

  // Baseline = original contract values (set once in V1, read-only after)
  baselineQty Decimal? @db.Decimal(15, 4)
  baselineRate Decimal? @db.Decimal(15, 4)

  // Delta from previous version
  previousQty Decimal? @db.Decimal(15, 4)
  previousRate Decimal? @db.Decimal(15, 4)

  version BoqVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  boqItem BoqItem    @relation(fields: [boqItemId], references: [id])

  @@index([versionId])
  @@index([boqItemId])
}

// ─────────────────────────────────────────────────────────────
// Global Rate Analysis Presets — shared across all projects
// ─────────────────────────────────────────────────────────────

model GlobalPresetAnalysis {
  id             String   @id @default(cuid())
  organizationId String? // null = global (super admin)
  name           String
  source         String   @default("Custom")
  category       String   @default("General")
  description    String?
  batchSize Decimal @db.Decimal(15, 2) @default(1)
  fiscalYear     String? // "2080/81"
  scope          String   @default("global") // "global" | "org"
  sourcePresetId String? // which global preset this was imported from
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredients  GlobalPresetIngredient[]

  @@index([category])
  @@index([organizationId])
}

model GlobalPresetIngredient {
  id         String @id @default(cuid())
  presetId   String
  name       String
  type       String // material | labor | equipment | overhead
  calcMode   String @default("fixed") // fixed | percentage
  quantity Decimal @db.Decimal(15, 4) @default(0)
  unit       String @default("")
  percentage Decimal @db.Decimal(15, 4) @default(0)
  pctBase    String @default("")
  rate Decimal @db.Decimal(15, 4) @default(0)
  amount Decimal @db.Decimal(15, 2) @default(0)
  sortOrder  Int    @default(0)

  // Link to canonical material name (for rate auto-pull)
  catalogMaterialId String?

  preset          GlobalPresetAnalysis @relation(fields: [presetId], references: [id], onDelete: Cascade)
  catalogMaterial CatalogMaterial?     @relation(fields: [catalogMaterialId], references: [id], onDelete: SetNull)

  @@index([presetId])
  @@index([catalogMaterialId])
}

// ─────────────────────────────────────────────────────────────
// Rate Profiles — rate libraries from different institutions
// (e.g. District Rate Morang, District Rate Sunsari, Project Rate)
// ─────────────────────────────────────────────────────────────

model RateProfile {
  id             String            @id @default(cuid())
  organizationId String? // null = project-level only (legacy)
  projectId      String? // null = org-level rate profile
  name           String
  description    String?
  category       String            @default("district_rate")
  scope          String            @default("project") // "org" | "project"
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items          RateProfileItem[]

  @@index([organizationId])
  @@index([projectId])
}

model RateProfileItem {
  id            String  @id @default(cuid())
  rateProfileId String
  materialName  String
  category      String? // Discipline/Trade Tag (e.g., "Civil & Concrete", "Steel & Rebar")
  subCategory   String? // Size/Spec Rating (e.g., "53 Grade OPC", "20mm", "12mm")
  unit          String
  rate Decimal @db.Decimal(15, 4) @default(0)

  // Link to canonical material name
  catalogMaterialId String?

  rateProfile     RateProfile      @relation(fields: [rateProfileId], references: [id], onDelete: Cascade)
  catalogMaterial CatalogMaterial? @relation(fields: [catalogMaterialId], references: [id], onDelete: SetNull)
  boqIngredients  BoqIngredient[]

  @@index([rateProfileId])
  @@index([catalogMaterialId])
}

// ─────────────────────────────────────────────────────────────
// Gantt / Scheduling module
// ─────────────────────────────────────────────────────────────

model GanttVersion {
  id              String         @id @default(cuid())
  projectId       String
  versionNumber   Int            @default(1) // Auto-increment: 1, 2, 3...
  name            String? // Optional custom name (e.g., "Baseline v1 - Design Complete")
  description     String? // Optional notes
  status          VersionStatus  @default(DRAFT) // DRAFT | APPROVED | ARCHIVED
  isActive        Boolean        @default(false) // Only ONE active per project
  baseVersionId   String? // The version this was cloned from (lineage)
  baseVersion     GanttVersion?  @relation("VersionLineage", fields: [baseVersionId], references: [id])
  derivedVersions GanttVersion[] @relation("VersionLineage")
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // ─── Dual Schedule + Revision Chain ───────────────────
  scheduleType   String         @default("PLANNING") // "PLANNING" | "EXECUTION"
  // For PLANNING revisions: chain of baselines (v1 → v2 → v3)
  revisionOfId   String? // Previous baseline this revision replaces
  revisionOf     GanttVersion?  @relation("BaselineRevision", fields: [revisionOfId], references: [id])
  revisedBy      GanttVersion[] @relation("BaselineRevision")
  revisionReason String? // Why this revision was created (e.g., "Monsoon delay")
  revisionStatus String         @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  submittedAt    DateTime?
  submittedById  String?
  approvalNote   String? // Client's comment on approval/rejection

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     GanttTask[]
  baseTasks GanttTask[] @relation("TaskBaseVersion")

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([projectId, isActive])
  @@index([projectId, scheduleType])
  @@index([revisionOfId])
}

model GanttTask {
  id              String    @id @default(cuid())
  projectId       String
  versionId       String? // Optional for backwards compatibility during migration, should be filled
  parentId        String?
  code            String? // WBS: 1.1.1
  name            String
  startDate       DateTime
  endDate         DateTime
  actualStartDate DateTime?
  actualEndDate   DateTime?
  duration        Int       @default(1) // days
  progress Decimal @db.Decimal(15, 4) @default(0) // 0..100

  // ─── Execution → Planning link (for variance tracking) ───
  planningTaskId String? // For EXECUTION tasks: the corresponding PLANNING task
  planningTask   GanttTask?  @relation("PlanningExecutionPair", fields: [planningTaskId], references: [id])
  executionTasks GanttTask[] @relation("PlanningExecutionPair")

  // Progress Inheritance Fields
  baseProgress Decimal? @db.Decimal(15, 4) @default(0) // Progress inherited from base version (0..100)
  isProgressEdited Boolean       @default(false) // True if user manually edited progress in this version
  baseVersionId    String? // Version from which progress was inherited
  baseVersion      GanttVersion? @relation("TaskBaseVersion", fields: [baseVersionId], references: [id])

  plannedValue Decimal @db.Decimal(15, 2) @default(0) // total planned cost (NPR) for this task (legacy/fallback)
  selectedCostLibraryId  String? // If linked to dynamic BOQ rates
  laborCount             Int       @default(0) // number of workers allocated
  assignees              String? // JSON string of user ids
  dependencies           String? // JSON: [{taskId, type: FS|SS|FF|SF, offset}]
  sortOrder              Int       @default(0)
  isMilestone            Boolean   @default(false)
  // ─── MS Project compatibility fields (all optional, default = no change) ───
  workHours Decimal @db.Decimal(15, 4) @default(0) // person-hours of effort (distinct from duration days)
  taskType               String    @default("fixed_duration") // fixed_duration | fixed_work | fixed_units
  constraintType         String    @default("asap") // asap | alap | mso | mfo | snlt | fnlt | fnet | snet
  constraintDate         DateTime? // for fixed constraints (mso, mfo, snlt, fnlt, fnet, snet)
  deadline               DateTime? // soft deadline (warning, not a hard constraint)
  notes                  String? // task notes (rich text from MS Project)
  effortDriven           Boolean   @default(false) // adding resources shortens duration
  estimated              Boolean   @default(false) // "3 days?" — task duration is an estimate
  ignoreResourceCalendar Boolean   @default(false) // task works through resource time off
  priority               Int       @default(500) // 0-1000, used for leveling (500 = default)
  earnedValueMethod      String    @default("percent_complete") // percent_complete | percent_work_complete
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version             GanttVersion?        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parent              GanttTask?           @relation("GanttTaskParent", fields: [parentId], references: [id], onDelete: Cascade)
  children            GanttTask[]          @relation("GanttTaskParent")
  boqLinks            TaskBoqLink[]
  rfis                Rfi[]
  dailyProgramTasks   DailyProgramTask[]
  predecessors        TaskDependency[]     @relation("TaskSuccessor")
  successors          TaskDependency[]     @relation("TaskPredecessor")
  resourceAssignments ResourceAssignment[]
  projectCosts        ProjectCost[]
  drawings            Drawing[]            @relation("DrawingGanttTask")
  equipmentLogs       EquipmentLog[]
  equipmentSpotHires  EquipmentSpotHire[]

  @@index([projectId, sortOrder])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────
// Resource Assignments — links tasks to staff roles / staff / equipment
// In PLANNING: assign generic roles (e.g. "Engineer 0+000-0+5000")
// In EXECUTION: assign specific staff to those roles
// ─────────────────────────────────────────────────────────────

model ResourceAssignment {
  id            String    @id @default(cuid())
  taskId        String
  staffRoleId   String? // link to a StaffRole (generic role assignment)
  staffId       String? // link to specific Staff (execution: who's filling the role)
  equipmentId   String? // link to specific Equipment
  quantity Decimal @db.Decimal(15, 4) @default(1) // headcount or units
  unit          String    @default("person")
  startDate     DateTime? // when this resource starts on this task
  endDate       DateTime? // null = until task ends
  notes         String?
  // ─── MS Project compatibility fields (optional) ───
  workHours Decimal @db.Decimal(15, 4) @default(0) // person-hours for this assignment
  resourceType  String    @default("work") // work | material | cost
  materialLabel String? // e.g., "bags", "m³" — for material resources
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task      GanttTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffRole StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  staff     Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([staffRoleId])
  @@index([staffId])
  @@index([equipmentId])
}

// Normalized task dependency model (replaces the JSON string in GanttTask.dependencies)
model TaskDependency {
  id            String   @id @default(cuid())
  predecessorId String // The task that must finish/start first
  successorId   String // The task that depends on the predecessor
  type          String   @default("FS") // FS, SS, FF, SF
  offset        Int      @default(0) // days offset (positive = lag, negative = lead)
  createdAt     DateTime @default(now())

  predecessor GanttTask @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   GanttTask @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

// Links a Gantt task to a BOQ item with a planned quantity.
// Used for resource loading: task duration × BOQ ingredient rates × quantity = material/labor needs.
model TaskBoqLink {
  id        String   @id @default(cuid())
  taskId    String
  boqItemId String
  quantity Decimal @db.Decimal(15, 4) @default(0) // planned quantity of this BOQ item for this task
  createdAt DateTime @default(now())

  task    GanttTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  boqItem BoqItem   @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  @@unique([taskId, boqItemId])
  @@index([taskId])
  @@index([boqItemId])
}

// ─────────────────────────────────────────────────────────────
// Reusable Work Package & Structure Templates (e.g. Box Culverts, Bridges, Pavement)
// ─────────────────────────────────────────────────────────────
model GanttTaskTemplate {
  id             String   @id @default(cuid())
  organizationId String?
  projectId      String?
  name           String
  category       String   @default("custom") // "structures" | "bridges" | "highways" | "buildings" | "custom"
  description    String?
  data           String // JSON stringified task tree and dependencies
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// Unified Partner model — supersedes Supplier & EquipmentVendor
// ─────────────────────────────────────────────────────────────

enum PartnerType {
  material_supplier
  equipment_vendor
  both
}

model Partner {
  id        String      @id @default(cuid())
  projectId String
  name      String
  type      PartnerType @default(material_supplier)
  contact   String?
  phone     String?
  email     String?
  address   String?
  pan       String?
  rating    Float       @default(0) // supplier rating (1-5)
  status    String      @default("active") // active | inactive
  code      String?
  regNumber String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrders    PurchaseOrder[]        @relation("PartnerPurchaseOrders")
  rentals           EquipmentRental[]      @relation("PartnerRentals")
  equipmentSpotHires EquipmentSpotHire[]
  supplies          PartnerSupply[]
  requisitionQuotes RequisitionItemQuote[]
  bills             VendorBill[]

  @@unique([projectId, name, type])
  @@index([projectId])
}

model PartnerSupply {
  id            String   @id @default(cuid())
  partnerId     String
  materialName  String
  brand         String? // e.g. "Shivam", "Kirloskar", "Tata Tiscon"
  specType      String? // e.g. "53 Grade OPC", "400 KVA", "12mm"
  unit          String
  exFactoryRate Decimal @db.Decimal(15, 4)
  transportRate Decimal @db.Decimal(15, 4)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  catalogMaterialId String?

  partner         Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  catalogMaterial CatalogMaterial? @relation(fields: [catalogMaterialId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([catalogMaterialId])
}

// ─────────────────────────────────────────────────────────────
// Materials & Logistics module
// ─────────────────────────────────────────────────────────────

model Material {
  id                 String                    @id @default(cuid())
  projectId          String
  resourceType       String                    @default("material") // "material" | "labor" | "equipment"
  name               String
  code               String?
  category           String?
  subCategory        String? // e.g. "20mm", "40mm", "12mm", "53 Grade"
  unit               String
  minStock Decimal @db.Decimal(15, 2) @default(0)
  currentStock Decimal @db.Decimal(15, 2) @default(0)
  reorderLevel Decimal @db.Decimal(15, 2) @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogMaterialId  String?
  catalogMaterial    CatalogMaterial?          @relation(fields: [catalogMaterialId], references: [id], onDelete: SetNull)
  mergedIntoId       String?
  mergedAt           DateTime?
  isActive           Boolean                   @default(true)
  transactions       MaterialTransaction[]
  storeStocks        MaterialStoreStock[]
  purchaseOrderItems PurchaseOrderItem[]
  boqIngredients     BoqIngredient[]
  requisitionItems   PurchaseRequisitionItem[]
  interSiteTransfers InterSiteTransfer[]

  @@index([projectId])
  @@index([catalogMaterialId])
}

model MaterialTransaction {
  id                String   @id @default(cuid())
  materialId        String
  projectId         String
  type              String // receive | issue | transfer | adjustment
  quantity Decimal @db.Decimal(15, 4)
  unit              String
  rate Decimal @db.Decimal(15, 4) @default(0)
  reference         String? // GRN no, issue slip no
  remarks           String?
  date              DateTime @default(now())
  createdById       String?
  isDebitable       Boolean  @default(false)
  subcontractorId   String?
  recoveryRate Decimal? @db.Decimal(15, 4)
  paymentType       String   @default("payable") // payable | unpayable | temporary
  gateEntryId       String?  @unique
  // Tracks which IPC this material deduction was already applied to —
  // prevents double-counting across multiple IPCs for the same subcontractor.
  deductedInIpcId   String?
  // Tax fields (only applicable to 'receive' transactions)
  vatPercent Decimal @db.Decimal(15, 4) @default(0) // VAT % applied (e.g. 13% in Nepal)
  vatAmount Decimal @db.Decimal(15, 2) @default(0) // computed: (quantity * rate) * vatPercent / 100
  tdsPercent Decimal @db.Decimal(15, 4) @default(0) // TDS % deducted at source
  tdsAmount Decimal @db.Decimal(15, 2) @default(0) // computed: (quantity * rate) * tdsPercent / 100
  totalWithVat Decimal @db.Decimal(15, 2) @default(0) // quantity * rate + vatAmount
  netPayable Decimal @db.Decimal(15, 2) @default(0) // totalWithVat - tdsAmount
  supplierInvoiceNo String? // supplier's invoice/bill number
  supplierPan       String? // supplier's PAN/Tax ID at time of transaction
  billedToEntity    String   @default("primary_org") // primary_org | dedicated_jv | lead_partner
  recipientPan      String?

  // Store Location & Transfer tracking
  storeLocationId       String?
  targetStoreLocationId String?
  storeLocation         StoreLocation? @relation("SourceStoreTransactions", fields: [storeLocationId], references: [id], onDelete: SetNull)
  targetStoreLocation   StoreLocation? @relation("TargetStoreTransactions", fields: [targetStoreLocationId], references: [id], onDelete: SetNull)

  // Weighbridge calculation fields
  weighbridgeGross Decimal? @db.Decimal(15, 2)
  weighbridgeTare Decimal? @db.Decimal(15, 2)
  densityFactor Decimal? @db.Decimal(15, 4)

  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  material          Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor     Subcontractor?   @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  gateEntry         GateEntry?       @relation(fields: [gateEntryId], references: [id], onDelete: SetNull)
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  catalogMaterialId String?
  catalogMaterial   CatalogMaterial? @relation(fields: [catalogMaterialId], references: [id], onDelete: SetNull)

  // Scanned Bill Attachment
  scannedBillUrl    String?
  scannedBillName   String?
  isBillAttached    Boolean  @default(false)

  @@index([materialId])
  @@index([projectId, date])
  @@index([subcontractorId])
  @@index([purchaseOrderId])
  @@index([catalogMaterialId])
  @@index([storeLocationId])
  @@index([targetStoreLocationId])
}

model Supplier {
  id             String          @id @default(cuid())
  projectId      String
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  pan            String? // tax id
  rating         Float           @default(0)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([projectId])
}

model PurchaseOrder {
  id            String                @id @default(cuid())
  projectId     String
  number        String
  supplierId    String?
  partnerId     String?
  status        String                @default("draft") // draft | issued | partially_received | received | cancelled
  orderDate     DateTime              @default(now())
  expectedDate  DateTime?
  totalAmount Decimal @db.Decimal(15, 2) @default(0)
  vatPercent Decimal @db.Decimal(15, 4) @default(13)
  vatAmount Decimal @db.Decimal(15, 2) @default(0)
  netAmount Decimal @db.Decimal(15, 2) @default(0)
  deliveryTerms String?
  paymentTerms  String?
  remarks       String?
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  partner       Partner?              @relation("PartnerPurchaseOrders", fields: [partnerId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]
  requisitionId String?
  requisition   PurchaseRequisition?  @relation("RequisitionPurchaseOrders", fields: [requisitionId], references: [id], onDelete: SetNull)
  transactions  MaterialTransaction[]
  bills         VendorBill[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([partnerId])
}

model PurchaseOrderItem {
  id                String                   @id @default(cuid())
  purchaseOrderId   String
  materialId        String
  requisitionItemId String?
  quantity Decimal @db.Decimal(15, 4)
  receivedQty Decimal @db.Decimal(15, 4) @default(0)
  unit              String
  rate Decimal @db.Decimal(15, 4)
  amount Decimal @db.Decimal(15, 2) @default(0)
  purchaseOrder     PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material          Material                 @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requisitionItem   PurchaseRequisitionItem? @relation(fields: [requisitionItemId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([requisitionItemId])
}

// ─────────────────────────────────────────────────────────────
// Equipment module
// ─────────────────────────────────────────────────────────────

model Equipment {
  id                  String                 @id @default(cuid())
  projectId           String
  name                String
  code                String?
  type                String? // excavator | mixer | crane | truck | pump
  model               String?
  serialNumber        String?
  capacity            String?
  unit                String                 @default("hrs") // hrs | km | day
  status              String                 @default("active") // active | maintenance | breakdown | idle
  fuelRate Decimal @db.Decimal(15, 4) @default(0) // L per hour
  factoryFuelRate Decimal @db.Decimal(15, 4) @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs                EquipmentLog[]
  maintenance         EquipmentMaintenance[]
  resourceAssignments ResourceAssignment[]
  rentals             EquipmentRental[]
  plants              Plant[]
  transfers           EquipmentTransfer[]

  @@index([projectId])
}

model EquipmentLog {
  id              String   @id @default(cuid())
  equipmentId     String
  projectId       String
  date            DateTime @default(now())
  startHours Decimal @db.Decimal(15, 4) @default(0)
  endHours Decimal @db.Decimal(15, 4) @default(0)
  workedHours Decimal @db.Decimal(15, 4) @default(0)
  fuelFilled Decimal @db.Decimal(15, 2) @default(0)
  workDescription String?
  operator        String?
  ganttTaskId     String?
  boqItemId       String?
  outputQty Decimal? @db.Decimal(15, 4)
  outputUnit      String?
  tripCount       Int?
  logMode         String   @default("meter") // meter | odometer | direct

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  ganttTask GanttTask? @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  boqItem   BoqItem?   @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@index([equipmentId, date])
  @@index([projectId, date])
  @@index([ganttTaskId])
  @@index([boqItemId])
}

model EquipmentMaintenance {
  id            String    @id @default(cuid())
  equipmentId   String
  projectId     String
  date          DateTime  @default(now())
  type          String // routine | repair | inspection
  description   String
  cost Decimal @db.Decimal(15, 2) @default(0)
  nextDueHours Decimal? @db.Decimal(15, 4)
  status        String    @default("pending") // pending | resolved
  resolvedDate  DateTime?
  resolvedNotes String?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// ─────────────────────────────────────────────────────────────
// Equipment Rental — tracks equipment rental to projects.
// Works for both external hires AND contractor's own fleet
// (internal cost allocation to project).
// Key feature: "stored on site" status stops rent accrual
// when work is done but equipment hasn't been physically moved.
// ─────────────────────────────────────────────────────────────

model EquipmentRental {
  id          String @id @default(cuid())
  equipmentId String
  projectId   String

  // Partner link (unified vendor/supplier)
  partnerId String?
  partner   Partner? @relation("PartnerRentals", fields: [partnerId], references: [id], onDelete: SetNull)

  // Vendor link (for external rentals, legacy)
  vendorId    String?
  isExternal  Boolean @default(false)
  vendorName  String? // kept for quick display even without vendor record
  vendorPhone String?

  // Rental terms
  rentalType       String    @default("daily") // daily | hourly | monthly | lump_sum
  rentalRate Decimal @db.Decimal(15, 4) @default(0)
  startDate        DateTime  @default(now())
  scheduledEndDate DateTime?

  // Maintenance terms — who maintains the equipment
  maintenanceBy            String @default("vendor") // vendor | contractor | shared
  maintenanceMinContractor Decimal @db.Decimal(15, 2) @default(0) // if shared: min NPR contractor pays before vendor covers
  consumablesBy            String @default("vendor") // vendor | contractor — grease, oil, filters, etc.

  // Agreement file (rental contract upload)
  agreementFileData String?
  agreementFileName String?
  agreementFileType String?

  // Storage/return tracking
  storedFromDate   DateTime?
  actualReturnDate DateTime?
  status           String    @default("active") // active | stored_on_site | returned

  // Cost summary (calculated)
  totalBillableDays Decimal? @db.Decimal(15, 2)
  totalRentalCost Decimal? @db.Decimal(15, 2)

  // Deductions from vendor bill
  totalDeductions Decimal @db.Decimal(15, 2) @default(0) // total NPR deducted from vendor (damage, late, etc.)

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor    EquipmentVendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  crew      EquipmentCrew[]
  damages   EquipmentDamage[]

  @@index([equipmentId])
  @@index([projectId, status])
  @@index([vendorId])
  @@index([partnerId])
}

// Equipment Crew — operators, drivers, helpers attached to a rental
// Tracks who pays what: vendor vs project for salary, allowance, lodging, fooding

model EquipmentCrew {
  id       String  @id @default(cuid())
  rentalId String
  name     String
  role     String  @default("operator") // operator | driver | helper | mechanic
  phone    String?

  // Salary
  salaryType   String @default("daily") // daily | hourly | monthly | lump_sum
  salaryRate Decimal @db.Decimal(15, 4) @default(0) // NPR per day/hour/month
  salaryPaidBy String @default("project") // vendor | project

  // Allowance (food/tea)
  allowanceType   String @default("daily") // daily | monthly | none
  allowanceRate Decimal @db.Decimal(15, 4) @default(0) // NPR per day/month
  allowancePaidBy String @default("project") // vendor | project

  // Lodging
  lodgingType   String @default("none") // project_provided | monthly_reimburse | per_diem | none
  lodgingRate Decimal @db.Decimal(15, 4) @default(0) // NPR (monthly rent or per-diem)
  lodgingPaidBy String @default("project") // vendor | project

  // Fooding
  foodingType   String @default("none") // project_provided | daily_allowance | none
  foodingRate Decimal @db.Decimal(15, 4) @default(0) // NPR per day
  foodingPaidBy String @default("project") // vendor | project

  // Period
  startDate DateTime  @default(now())
  endDate   DateTime? // null = still on this rental

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rental EquipmentRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
}

// ─────────────────────────────────────────────────────────────
// Equipment Vendor — suppliers of rented equipment
// Tracks total cost incurred, deductions, and per-vendor summary
// ─────────────────────────────────────────────────────────────

model EquipmentVendor {
  id        String   @id @default(cuid())
  projectId String
  name      String
  contact   String?
  phone     String?
  email     String?
  pan       String?
  address   String?
  status    String   @default("active") // active | inactive
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rentals   EquipmentRental[]
  spotHires EquipmentSpotHire[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Equipment Damage — tracks damage incidents with responsibility
// ─────────────────────────────────────────────────────────────

model EquipmentDamage {
  id               String    @id @default(cuid())
  rentalId         String
  date             DateTime  @default(now())
  description      String
  damageType       String    @default("normal_wear") // normal_wear | negligence | accident | force_majeure
  responsibleParty String    @default("contractor") // contractor | vendor | shared | third_party
  repairCost Decimal @db.Decimal(15, 2) @default(0)
  paidBy           String    @default("contractor") // contractor | vendor | insurance | shared
  contractorShare Decimal? @db.Decimal(15, 2) // if shared, contractor's portion
  vendorShare Decimal? @db.Decimal(15, 2) // if shared, vendor's portion
  status           String    @default("reported") // reported | assessed | repaired | disputed
  photoData        String? // base64 photo of damage
  photoName        String?
  photoType        String?
  resolvedDate     DateTime?
  resolvedNotes    String?
  createdById      String?
  createdAt        DateTime  @default(now())

  rental EquipmentRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Equipment Spot Hire — on-demand / casual machine hire tickets
// For ad-hoc hourly/trip hires with auto-vendor setup and fuel debits
// ─────────────────────────────────────────────────────────────

model EquipmentSpotHire {
  id               String    @id @default(cuid())
  projectId        String
  vendorId         String?
  partnerId        String?
  vendorName       String
  vendorPhone      String?
  machineName      String
  registrationNo   String?
  equipmentType    String    @default("excavator") // excavator | crane | pump | roller | tipper | grader | loader | other
  hireType         String    @default("hourly") // hourly | trip | daily | shift | lump_sum
  rate Decimal @db.Decimal(15, 4) @default(0)
  minCalloutHours Decimal @db.Decimal(15, 4) @default(0)
  mobilizationFee Decimal @db.Decimal(15, 2) @default(0)
  fuelMode         String    @default("wet") // wet | dry
  fuelLitersIssued Decimal @db.Decimal(15, 2) @default(0)
  fuelUnitCost Decimal @db.Decimal(15, 2) @default(0)
  date             DateTime  @default(now())
  startTime        String?
  endTime          String?
  hoursWorked Decimal @db.Decimal(15, 4) @default(0)
  tripCount        Int       @default(0)
  totalGross Decimal @db.Decimal(15, 2) @default(0)
  fuelDeduction Decimal @db.Decimal(15, 2) @default(0)
  netPayable Decimal @db.Decimal(15, 2) @default(0)
  operatorName     String?
  operatorPhone    String?
  slipNumber       String?
  remarks          String?
  ganttTaskId      String?
  boqItemId        String?
  isBilled         Boolean   @default(false)
  vendorBillId     String?
  paymentStatus    String    @default("unpaid") // unpaid | paid
  paymentReference String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor     EquipmentVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  partner    Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  ganttTask  GanttTask?       @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  boqItem    BoqItem?         @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  vendorBill VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([vendorId])
  @@index([partnerId])
  @@index([isBilled])
  @@index([ganttTaskId])
  @@index([boqItemId])
}

// ─────────────────────────────────────────────────────────────
// Plant & Production module
// ─────────────────────────────────────────────────────────────

model Plant {
  id            String   @id @default(cuid())
  projectId     String
  name          String // e.g. "Main Concrete Batching Plant CP-30", "Asphalt Drum Mix Plant DM-50"
  code          String? // e.g. "CBP-01", "HMP-01", "WMM-01"
  type          String   @default("concrete_batching") // concrete_batching | asphalt_hot_mix | wmm_wet_mix | crusher
  makeModel     String? // e.g. "Schwing Stetter CP30", "Apollo DM-50"
  capacityValue Decimal? @db.Decimal(15, 2) // e.g. 30, 60, 90
  capacityUnit  String?  @default("cum/hr") // cum/hr | TPH | ton/hr
  location      String? // e.g. "Base Camp KM 12+400"
  status        String   @default("active") // active | maintenance | idle | decommissioned
  equipmentId   String? // optional linked equipment fleet ID
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment    Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  mixDesigns   PlantMixDesign[]
  batchTickets PlantBatchTicket[]
  silos        PlantSilo[]
  dailyLogs    PlantDailyLog[]

  @@index([projectId, status])
}

model PlantMixDesign {
  id                String   @id @default(cuid())
  projectId         String
  plantId           String
  code              String // e.g. "M25-PCC", "M30-RCC", "DBM-50", "AC-40"
  name              String // e.g. "M25 Pavement Concrete", "Dense Bituminous Macadam"
  type              String   @default("concrete") // concrete | asphalt | wmm | aggregate
  targetSlumpMm     Float? // e.g. 100 mm
  targetTempC       Float? // e.g. 155 °C
  waterCementRatio Decimal? @db.Decimal(15, 4) // e.g. 0.42
  bitumenContentPct Decimal? @db.Decimal(15, 4) // e.g. 4.5%
  unit              String   @default("cum") // cum | ton
  status            String   @default("approved") // approved | trial | archived
  boqItemId         String?
  ingredients       String? // JSON: [{ name, type, dosagePerUnit, unit }]
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plant        Plant              @relation(fields: [plantId], references: [id], onDelete: Cascade)
  boqItem      BoqItem?           @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  batchTickets PlantBatchTicket[]

  @@index([projectId])
  @@index([plantId])
}

model PlantBatchTicket {
  id               String    @id @default(cuid())
  projectId        String
  plantId          String
  mixDesignId      String?
  ticketNumber     String // e.g. "BT-20260815-001"
  dispatchDate     DateTime  @default(now())
  transitVehicleNo String // e.g. "Ba 2 Kha 9012"
  driverName       String?
  driverPhone      String?
  orderedQty Decimal @db.Decimal(15, 4) @default(0)
  dispatchedQty Decimal @db.Decimal(15, 4) @default(0)
  receivedQty Decimal? @db.Decimal(15, 4)
  unit             String    @default("cum") // cum | ton
  slumpMm          Float?
  temperatureC     Float?
  batchStartTime   DateTime?
  batchEndTime     DateTime?
  siteLocation     String? // e.g. "KM 4+250 Culvert"
  targetStructure  String? // e.g. "Base Slab", "PQC Lane 1"
  rfiId            String?
  dailyReportId    String?
  status           String    @default("dispatched") // dispatched | in_transit | delivered | rejected | cancelled
  rejectionReason  String?
  remarks          String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plant     Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  mixDesign PlantMixDesign? @relation(fields: [mixDesignId], references: [id], onDelete: SetNull)
  rfi       Rfi?            @relation(fields: [rfiId], references: [id], onDelete: SetNull)

  @@index([projectId, dispatchDate])
  @@index([plantId, status])
  @@index([ticketNumber])
}

model PlantSilo {
  id            String    @id @default(cuid())
  plantId       String
  name          String // e.g. "Cement Silo 1 (100 MT)", "Bin 1 - 20mm Agg", "Bitumen Tank 1"
  materialType  String // cement | sand | aggregate_10mm | aggregate_20mm | aggregate_40mm | bitumen | admixture | filler
  capacity Decimal @db.Decimal(15, 2) @default(0)
  currentStock Decimal @db.Decimal(15, 2) @default(0)
  unit          String    @default("MT") // MT | cum | kg | liter
  minAlertLevel Decimal? @db.Decimal(15, 2)
  lastDipDate   DateTime?
  lastDipValue Decimal? @db.Decimal(15, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
}

model PlantDailyLog {
  id                  String   @id @default(cuid())
  projectId           String
  plantId             String
  logDate             DateTime @default(now())
  totalBatches        Int      @default(0)
  totalProduced Decimal @db.Decimal(15, 2) @default(0)
  unit                String   @default("cum")
  operatingHours Decimal @db.Decimal(15, 4) @default(0)
  idleHours Decimal @db.Decimal(15, 4) @default(0)
  breakdownHours Decimal @db.Decimal(15, 4) @default(0)
  electricityUnitsKwh Decimal? @db.Decimal(15, 2)
  dieselLitres Decimal? @db.Decimal(15, 2)
  downtimeReason      String?
  operatorName        String?
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plant   Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([plantId, logDate])
  @@index([projectId, logDate])
}

model Document {
  id           String             @id @default(cuid())
  projectId    String
  number       String // doc number
  title        String
  type         String             @default("general") // drawing | spec | contract | report | letter | general
  discipline   String? // civil | structural | electrical | mechanical
  status       String             @default("active") // active | superseded | void
  revision     String             @default("A")
  issuedDate   DateTime?
  receivedFrom String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions    DocumentRevision[]
  transmittals TransmittalItem[]

  @@unique([projectId, number])
  @@index([projectId, type])
}

model DocumentRevision {
  id          String   @id @default(cuid())
  documentId  String
  revision    String
  issuedDate  DateTime @default(now())
  description String?
  issuedBy    String?
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Transmittal {
  id        String            @id @default(cuid())
  projectId String
  number    String
  date      DateTime          @default(now())
  sentTo    String
  sentBy    String
  status    String            @default("sent") // sent | acknowledged | returned
  remarks   String?
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     TransmittalItem[]

  @@unique([projectId, number])
  @@index([projectId, date])
}

model TransmittalItem {
  id            String      @id @default(cuid())
  transmittalId String
  documentId    String
  revision      String
  copies        Int         @default(1)
  transmittal   Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([transmittalId])
}

// ─────────────────────────────────────────────────────────────
// Drawings module
// ─────────────────────────────────────────────────────────────

model Drawing {
  id             String    @id @default(cuid())
  projectId      String
  number         String
  title          String
  discipline     String? // civil | structural | electrical | mechanical | architectural
  status         String    @default("current") // current | superseded | void
  revision       String    @default("A")
  issuedDate     DateTime?
  fileData       String? // base64-encoded file content (current revision's file)
  fileName       String?
  fileType       String?
  // NEW: Gantt task reference
  ganttTaskId    String?
  // NEW: Approval workflow
  approvalStatus String    @default("pending") // pending | approved_internal | approved_consultant | approved_client | rejected
  approvedById   String?
  approvedAt     DateTime?
  approvalNotes  String?
  // NEW: Creator
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Drawing scale for real-world measurements
  scaleValue Decimal? @db.Decimal(15, 2) // e.g. 100 for 1:100
  scaleUnit      String?   @default("m") // m | mm | ft | in

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ganttTask    GanttTask?        @relation("DrawingGanttTask", fields: [ganttTaskId], references: [id], onDelete: SetNull)
  revisions    DrawingRevision[]
  rfis         Rfi[]
  markups      DrawingMarkup[]
  punchItems   PunchItem[]
  drawingSetId String?
  drawingSet   DrawingSet?       @relation(fields: [drawingSetId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([projectId, discipline])
  @@index([projectId, status])
  @@index([ganttTaskId])
}

model DrawingRevision {
  id             String    @id @default(cuid())
  drawingId      String
  revision       String
  issuedDate     DateTime  @default(now())
  description    String?
  issuedBy       String?
  // NEW: File data for this specific revision
  fileData       String?
  fileName       String?
  fileType       String?
  // NEW: Approval for this revision
  approvalStatus String    @default("pending") // pending | approved_internal | approved_consultant | approved_client | rejected
  approvedById   String?
  approvedAt     DateTime?
  approvalNotes  String?
  // NEW: Creator
  createdById    String?
  createdAt      DateTime  @default(now())
  drawing        Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@index([drawingId])
}

// ─────────────────────────────────────────────────────────────
// IPC (Interim Payment Certificate) module
// ─────────────────────────────────────────────────────────────

model Ipc {
  id              String         @id @default(cuid())
  projectId       String
  number          String
  period          String?
  status          String         @default("draft")
  grossAmount Decimal @db.Decimal(15, 2) @default(0)
  retention Decimal @db.Decimal(15, 2) @default(0)
  retentionAmount Decimal @db.Decimal(15, 2) @default(0)
  advanceRecovery Decimal @db.Decimal(15, 2) @default(0)
  netPayable Decimal @db.Decimal(15, 2) @default(0)
  // Tax fields
  vatPercent Decimal @db.Decimal(15, 4) @default(13) // Nepal VAT 13%
  vatAmount Decimal @db.Decimal(15, 2) @default(0)
  tdsPercent Decimal @db.Decimal(15, 4) @default(0) // TDS on contractor payment (varies 1.5%-10%)
  tdsAmount Decimal @db.Decimal(15, 2) @default(0)
  totalWithVat Decimal @db.Decimal(15, 2) @default(0) // grossAmount + vatAmount
  finalPayable Decimal @db.Decimal(15, 2) @default(0) // totalWithVat - retention - advance - tds
  issueDate       DateTime?

  // Retention release tracking — set by `releaseRetention` mutation.
  // Prevents duplicate journal entries on re-run: the query filters
  // `retentionReleasedAt: null` so already-released IPCs are skipped.
  // Without this field, re-running releaseRetention (double-click,
  // accidental re-trigger) would generate the same release journal
  // entries a second time, double-crediting revenue.
  retentionReleasedAt DateTime?
  retentionReleasedById String?


  // Official Nepal Tax Invoice & Client Metadata
  taxInvoiceNo    String?        // Client Tax Invoice number
  taxInvoiceDate  DateTime?
  clientPan       String?
  clientName      String?

  // Nepal Contract & Mobilization Metadata (Summary of Payment)
  contractAgreementDate              DateTime?
  workCommenceDate                   DateTime?
  contractCompletionDate             DateTime?
  originalContractAmountWithoutVat Decimal? @db.Decimal(15, 2)
  originalContractAmountWithVat Decimal? @db.Decimal(15, 2)
  mobilizationAdvanceTotal Decimal? @db.Decimal(15, 2)
  mobilizationAdvanceDeducted Decimal? @db.Decimal(15, 2)
  mobilizationAdvanceRate Decimal? @db.Decimal(15, 4) @default(30)
  submittedBy                        String?
  submittedByLocation                String?
  checkedBy                          String?
  checkedByLocation                  String?
  approvedBy                         String?
  approvedByLocation                 String?

  // Cumulative Previous IPC Totals
  previousGrossAmount Decimal @db.Decimal(15, 2) @default(0)
  previousVatAmount Decimal @db.Decimal(15, 2) @default(0)
  previousAdvanceRecovery Decimal @db.Decimal(15, 2) @default(0)
  previousRetentionAmount Decimal @db.Decimal(15, 2) @default(0)
  previousTdsAmount Decimal @db.Decimal(15, 2) @default(0)
  previousFinalPayable Decimal @db.Decimal(15, 2) @default(0)

  // Scanned Copy Attachment (Soft-mandatory)
  scannedBillUrl  String?
  scannedBillName String?
  isBillAttached  Boolean        @default(false)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items           IpcItem[]
  subcontractor   Subcontractor? @relation(fields: [subcontractorId], references: [id])
  subcontractorId String?
  boqVersionId    String?
  boqVersion      BoqVersion?    @relation(fields: [boqVersionId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([projectId, status])
}

// ─────────────────────────────────────────────────────────────
// VatBill — Central VAT Bill Entry for Standalone / Direct Bills
// ─────────────────────────────────────────────────────────────

model VatBill {
  id                  String   @id @default(cuid())
  projectId           String
  billType            String   @default("purchase") // purchase | sales | expense | capital_goods | import
  billNumber          String
  billDate            DateTime @default(now())
  billMiti            String?  // Nepali BS Date
  partyName           String
  partyPan            String?
  partyAddress        String?
  taxableAmount Decimal @db.Decimal(15, 2) @default(0)
  exemptAmount Decimal @db.Decimal(15, 2) @default(0)
  vatPercent Decimal @db.Decimal(15, 4) @default(13)
  vatAmount Decimal @db.Decimal(15, 2) @default(0)
  totalAmount Decimal @db.Decimal(15, 2) @default(0)
  tdsPercent Decimal @db.Decimal(15, 4) @default(0)
  tdsAmount Decimal @db.Decimal(15, 2) @default(0)
  netPayable Decimal @db.Decimal(15, 2) @default(0)
  category            String?  // material | subcontractor | equipment | office_overhead | site_expense | client_ipc | other
  billedToEntity      String   @default("primary_org") // primary_org | dedicated_jv | lead_partner
  recipientPan        String?
  description         String?
  scannedBillUrl      String?
  scannedBillName     String?
  isBillAttached      Boolean  @default(false)
  materialTxnId       String?
  ipcId               String?
  subcontractorBillId String?
  equipmentSpotHireId String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, billDate])
  @@index([projectId, billType])
  @@index([partyPan])
}

model IpcItem {
  id          String  @id @default(cuid())
  ipcId       String
  boqCode     String?
  description String
  unit        String
  section     String? // e.g. "A) Provisional Items", "B) Civil Cost"
  contractQty Decimal @db.Decimal(15, 4) @default(0)
  previousQty Decimal @db.Decimal(15, 4) @default(0)
  thisQty Decimal @db.Decimal(15, 4) @default(0)
  cumQty Decimal @db.Decimal(15, 4) @default(0)
  rate Decimal @db.Decimal(15, 4) @default(0)
  amount Decimal @db.Decimal(15, 2) @default(0) // this period amount = thisQty * rate
  sortOrder   Int     @default(0)
  ipc         Ipc     @relation(fields: [ipcId], references: [id], onDelete: Cascade)

  @@index([ipcId])
}

// ─────────────────────────────────────────────────────────────
// HR / Staff module
// ─────────────────────────────────────────────────────────────

model Staff {
  id                  String                @id @default(cuid())
  projectId           String
  name                String
  designation         String?
  category            String? // skilled | unskilled | supervisor | staff | operator
  employmentType      String                @default("daily") // daily | monthly | piece_rate
  phone               String?
  dailyWage Decimal @db.Decimal(15, 2) @default(0)
  monthlySalary Decimal @db.Decimal(15, 2) @default(0)
  gangName            String? // e.g. "Mason Gang A", "Carpentry Toli"
  bankAccountNo       String?
  bankName            String?
  pan                 String?
  idNumber            String? // Citizenship / ID no
  status              String                @default("active") // active | inactive | left
  joinedDate          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendance          StaffAttendance[]
  roleAssignments     StaffRoleAssignment[]
  resourceAssignments ResourceAssignment[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  advances            StaffAdvance[]
  payrollRecords      PayrollStaffRecord[]

  @@index([projectId])
  @@index([status])
  @@index([gangName])
}

// ─────────────────────────────────────────────────────────────
// Staff Roles — hierarchy of roles for planning schedules
// e.g. "Engineer 0+000-0+5000", "Mason Team A", "Excavator Operator"
// Roles are assigned to planning tasks; specific staff are assigned
// to roles in the execution schedule.
// ─────────────────────────────────────────────────────────────

model StaffRole {
  id           String   @id @default(cuid())
  projectId    String
  parentId     String? // hierarchy support
  name         String // e.g. "Engineer 0+000-0+5000"
  category     String   @default("staff") // engineer | mason | labor | operator | supervisor | staff
  chainageFrom Float? // 0 (for linear projects, in meters)
  chainageTo   Float? // 5000
  headcount    Int      @default(1) // how many people needed for this role
  dailyWage Decimal @db.Decimal(15, 2) @default(0) // expected daily cost per person
  skills       String? // JSON array: ["RCC certified", "Height work"]
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          StaffRole?            @relation("StaffRoleParent", fields: [parentId], references: [id], onDelete: Cascade)
  children        StaffRole[]           @relation("StaffRoleParent")
  assignments     StaffRoleAssignment[]
  taskAssignments ResourceAssignment[]

  @@index([projectId])
  @@index([parentId])
}

// Links specific staff to a role (with date ranges for turnover tracking)
// When staff quits: set endDate, create new assignment for replacement
model StaffRoleAssignment {
  id          String    @id @default(cuid())
  staffRoleId String
  staffId     String
  startDate   DateTime  @default(now())
  endDate     DateTime? // null = currently assigned
  notes       String?
  createdAt   DateTime  @default(now())

  staffRole StaffRole @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffRoleId, endDate])
  @@index([staffId])
}

model StaffAttendance {
  id        String   @id @default(cuid())
  staffId   String
  projectId String
  date      DateTime
  status    String // present | absent | half_day | leave | overtime
  hours Decimal @db.Decimal(15, 4) @default(8)
  overtime Decimal @db.Decimal(15, 2) @default(0)
  remarks   String?
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([projectId, date])
}

// ─────────────────────────────────────────────────────────────
// Construction HR: Site Advances & Deductions Ledger
// ─────────────────────────────────────────────────────────────

model StaffAdvance {
  id                  String      @id @default(cuid())
  projectId           String
  staffId             String
  date                DateTime    @default(now())
  amount Decimal @db.Decimal(15, 2)
  type                String      @default("cash_advance") // cash_advance | mess_deduction | safety_gear | other
  isRecovered         Boolean     @default(false)
  recoveredInPayrollId String?
  remarks             String?
  createdById         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staff      Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [recoveredInPayrollId], references: [id], onDelete: SetNull)

  @@index([projectId, staffId])
  @@index([isRecovered])
}

// ─────────────────────────────────────────────────────────────
// Construction HR: Monthly Payroll Runs & Payslip Line Records
// ─────────────────────────────────────────────────────────────

model PayrollRun {
  id                    String               @id @default(cuid())
  projectId             String
  month                 String // "YYYY-MM", e.g. "2026-08"
  runDate               DateTime             @default(now())
  status                String               @default("draft") // draft | approved | disbursed
  totalStaffCount       Int                  @default(0)
  totalGross Decimal @db.Decimal(15, 2) @default(0)
  totalAllowances Decimal @db.Decimal(15, 2) @default(0)
  totalDeductions Decimal @db.Decimal(15, 2) @default(0)
  totalAdvancesRecovered Decimal @db.Decimal(15, 2) @default(0)
  totalNetPayable Decimal @db.Decimal(15, 2) @default(0)
  disbursedAmount Decimal @db.Decimal(15, 2) @default(0)
  approvedById          String?
  approvedAt            DateTime?
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records  PayrollStaffRecord[]
  advances StaffAdvance[]

  @@unique([projectId, month])
  @@index([projectId, status])
}

model PayrollStaffRecord {
  id               String   @id @default(cuid())
  payrollRunId     String
  staffId          String
  employmentType   String   @default("daily") // daily | monthly | piece_rate
  presentDays Decimal @db.Decimal(15, 2) @default(0)
  halfDays Decimal @db.Decimal(15, 2) @default(0)
  absentDays Decimal @db.Decimal(15, 2) @default(0)
  leaveDays Decimal @db.Decimal(15, 2) @default(0)
  overtimeHours Decimal @db.Decimal(15, 4) @default(0)
  baseRate Decimal @db.Decimal(15, 4) @default(0) // daily wage or monthly salary
  regularPay Decimal @db.Decimal(15, 2) @default(0)
  overtimePay Decimal @db.Decimal(15, 2) @default(0)
  allowances Decimal @db.Decimal(15, 2) @default(0) // site / hardship / night allowances
  advanceDeduction Decimal @db.Decimal(15, 2) @default(0) // cash advance recovery
  messDeduction Decimal @db.Decimal(15, 2) @default(0) // canteen / fooding
  otherDeductions Decimal @db.Decimal(15, 2) @default(0)
  tdsAmount Decimal @db.Decimal(15, 2) @default(0)
  netPayable Decimal @db.Decimal(15, 2) @default(0)
  paidAmount Decimal @db.Decimal(15, 2) @default(0)
  paymentStatus    String   @default("unpaid") // unpaid | paid | partial
  paymentMethod    String   @default("cash") // cash | bank_transfer | cheque
  paymentReference String?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, staffId])
  @@index([payrollRunId])
  @@index([staffId])
}

// ─────────────────────────────────────────────────────────────
// Daily Program module
// ─────────────────────────────────────────────────────────────

model DailyProgram {
  id           String             @id @default(cuid())
  projectId    String
  programDate  DateTime
  status       String             @default("draft") // draft | approved
  approvedAt   DateTime?
  approvedById String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        DailyProgramTask[]

  @@unique([projectId, programDate])
  @@index([projectId, programDate])
}

model DailyProgramTask {
  id              String  @id @default(cuid())
  programId       String
  rfiId           String? // linked RFI (source of this work item)
  rfiItemId       String? // specific RFI line item
  ganttTaskId     String? // linked Gantt task
  subcontractorId String? // linked subcontractor (if work is subbed out)
  taskName        String
  location        String?
  boqItemId       String? // linked BOQ item
  boqCode         String?
  boqDesc         String?
  plannedQty Decimal @db.Decimal(15, 4) @default(0)
  unit            String?
  paymentType     String  @default("payable") // payable | unpayable | temporary
  assignedTo      String?
  remarks         String?

  // NEW Fields for execution tracking
  executionStatus String @default("planned") // planned | done | partially_completed | uncompleted | postponed
  actualQty Decimal? @db.Decimal(15, 4) @default(0) // Filled in via Daily Report
  batchedQty Decimal? @db.Decimal(15, 4) @default(0)
  payableQty Decimal? @db.Decimal(15, 4) @default(0)

  // Delay & EOT Tracking
  delayReason    String? // weather | material | equipment | labor | client | other
  delayNotes     String?
  isEotCandidate Boolean @default(false)

  // Provenance / Carry-over tracking
  carriedOverFromId String?
  carriedOverFrom   DailyProgramTask?  @relation("TaskCarryOver", fields: [carriedOverFromId], references: [id])
  carriedOverTo     DailyProgramTask[] @relation("TaskCarryOver")

  // Cancellation workflow
  cancellationStatus      String    @default("none") // none | pending | approved | rejected
  cancellationRequestedAt DateTime?
  cancellationRequestedBy String? // user id
  cancellationReason      String?
  cancellationRespondedAt DateTime?
  cancellationResponse    String? // PM's response notes
  cancellationApprovedBy  String? // user id (PM who approved/rejected)

  program       DailyProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  rfi           Rfi?           @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  boqItem       BoqItem?       @relation(fields: [boqItemId], references: [id])
  ganttTask     GanttTask?     @relation(fields: [ganttTaskId], references: [id])
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)

  @@index([programId])
  @@index([rfiId])
  @@index([ganttTaskId])
  @@index([subcontractorId])
}

// ─────────────────────────────────────────────────────────────
// Audit log — replaces the silent cascade-deletes of the old app
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id                   String   @id @default(cuid())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action               String // e.g. "project.create", "rfi.submit", "rfi.approve"
  entityType           String
  entityId             String
  metadata             String? // JSON string
  ipAddress            String?
  impersonatedOrgId    String? // set when the actor was impersonating a tenant
  impersonatedByUserId String? // the real superadmin who performed the action while impersonating
  createdAt            DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([impersonatedOrgId])
}

// ─────────────────────────────────────────────────────────────
// Gate Entry & Subcontractor Models
// ─────────────────────────────────────────────────────────────

model GateEntry {
  id          String   @id @default(cuid())
  projectId   String
  number      String // GP-0001
  vehicleNo   String
  driverName  String?
  challanNo   String?
  description String?
  estQty Decimal? @db.Decimal(15, 4)
  grossWeight Decimal? @db.Decimal(15, 4)
  tareWeight Decimal? @db.Decimal(15, 4)
  netWeight Decimal? @db.Decimal(15, 4)
  unit        String?
  fileUrl     String? // Challan / Weighbridge slip photo
  status      String   @default("pending") // pending | received | rejected
  createdAt   DateTime @default(now())

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grn     MaterialTransaction?

  @@unique([projectId, number])
  @@index([projectId])
}

model Subcontractor {
  id                     String   @id @default(cuid())
  projectId              String
  name                   String
  contact                String?
  phone                  String?
  email                  String?
  pan                    String?
  status                 String   @default("active") // active | inactive
  // Retention tracking
  totalRetentionHeld Decimal @db.Decimal(15, 2) @default(0) // cumulative retention deducted from IPCs
  totalRetentionReleased Decimal @db.Decimal(15, 2) @default(0) // cumulative retention paid back
  contractValue Decimal @db.Decimal(15, 2) @default(0) // total contract amount (for % tracking)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ipcs                 Ipc[]
  rfis                 Rfi[]
  dailyProgramTasks    DailyProgramTask[]
  projectCosts         ProjectCost[]
  bills                SubcontractorBill[]
  materialTransactions MaterialTransaction[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Phase 3: BOQ Variation Orders
// ─────────────────────────────────────────────────────────────

model VariationOrder {
  id           String    @id @default(cuid())
  projectId    String
  number       String // e.g. VO-001
  title        String
  description  String?
  status       String    @default("draft") // draft | submitted | approved | rejected
  dateIssued   DateTime  @default(now())
  dateApproved DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       VariationOrderItem[]
  boqVersions BoqVersion[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

model VariationOrderItem {
  id               String @id @default(cuid())
  variationOrderId String

  boqItemId String? // if modifying existing BOQ item
  boqCode   String // e.g. "1.2.3"
  boqDesc   String
  unit      String

  // Delta Tracking
  previousQty Decimal @db.Decimal(15, 4) @default(0)
  newQty Decimal @db.Decimal(15, 4) @default(0)

  previousRate Decimal @db.Decimal(15, 4) @default(0)
  newRate Decimal @db.Decimal(15, 4) @default(0)

  variationOrder VariationOrder @relation(fields: [variationOrderId], references: [id], onDelete: Cascade)
  boqItem        BoqItem?       @relation(fields: [boqItemId], references: [id])

  @@index([variationOrderId])
  @@index([boqItemId])
}

// ─────────────────────────────────────────────────────────────
// Report Templates — saved PDF layouts for the cell-based designer
// ─────────────────────────────────────────────────────────────

model ReportTemplate {
  id             String   @id @default(cuid())
  name           String
  entityType     String // "daily_report" | "rfi" | "boq" | "ipc" | "schedule" | ...
  scope          String   @default("user") // "global" | "organization" | "project" | "user"
  projectId      String?
  ownerId        String?
  organizationId String?
  layout         String // JSON: { page, cells: [...] }
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?         @relation("ReportTemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([entityType, scope])
  @@index([projectId])
  @@index([ownerId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────
// Approved Documents — signed hardcopy archive for any exportable entity
// (daily_report, rfi, ipc, boq, schedule, etc.)
// ─────────────────────────────────────────────────────────────

model ApprovedDocument {
  id           String   @id @default(cuid())
  projectId    String
  entityType   String // "daily_report" | "rfi" | "ipc" | "boq" | "schedule" | ...
  entityId     String // the entity's ID (reportId, rfiId, ipcId, projectId for BOQ, versionId for schedule)
  documentType String // "generated_pdf" | "signed_hardcopy" | "supporting_doc"
  fileName     String
  fileType     String // MIME type
  fileSize     Int // bytes
  data         String // base64-encoded file content
  uploadedById String
  uploadedAt   DateTime @default(now())

  // Optional metadata for signed hardcopies
  signedBy   String? // client name who signed
  signedAt   DateTime? // when the client signed
  receivedAt DateTime? // when PM received the physical copy
  notes      String?

  // For generated PDFs: the template/layout config used (JSON string)
  pdfConfig String?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ApprovedDocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────────────────────
// Project Cost Ledger — auto-captured + manual expenses
// (Procore-style: field data capture, NOT double-entry accounting)
// ─────────────────────────────────────────────────────────────

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @default(now())
  amount Decimal @db.Decimal(15, 2)
  category    String // material | labor | equipment | subcontractor | overhead
  subcategory String? // e.g. "Cement", "Fuel", "Skilled Labor"
  description String?

  // Optional links for variance analysis
  boqItemId       String? // linked BOQ item
  ganttTaskId     String? // linked Gantt task
  subcontractorId String? // for subcontractor payments

  // Source tracking
  source      String  @default("manual") // manual | daily_report | ipc | purchase_order
  sourceRef   String? // report number, IPC number, PO number
  sourceRefId String? // the entity ID (reportId, ipcId, poId)

  // Manual expense metadata
  vendor          String? // payee name
  paymentMode     String? // cash | bank_transfer | cheque | mobile_pay
  receiptData     String? // base64-encoded receipt photo
  receiptFileType String?
  notes           String?

  createdById String
  createdAt   DateTime @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem       BoqItem?       @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  ganttTask     GanttTask?     @relation(fields: [ganttTaskId], references: [id], onDelete: SetNull)
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("ProjectCostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([projectId, category])
  @@index([boqItemId])
  @@index([ganttTaskId])
  @@index([source])
}

// ─────────────────────────────────────────────────────────────
// Correspondence Register — formal letter tracking with full
// traceability and accountability for incoming/outgoing letters.
// ─────────────────────────────────────────────────────────────

model Correspondence {
  id        String @id @default(cuid())
  projectId String

  // Direction & parties
  direction    String    @default("incoming") // incoming | outgoing
  theirRef     String?
  ourRef       String?
  date         DateTime  @default(now())
  receivedDate DateTime?
  fromParty    String?
  fromName     String?
  toParty      String?
  toName       String?
  subject      String
  category     String    @default("other") // qc | design | site | account | contract | safety | procurement | other
  letterType   String    @default("informative") // informative | actionable | eot_claim | variation_order

  // Thread linking — this letter replies to another letter
  repliesToId String? // if this is a reply, points to the original letter
  repliesTo   Correspondence?  @relation("LetterThread", fields: [repliesToId], references: [id], onDelete: SetNull)
  replies     Correspondence[] @relation("LetterThread")

  // CC / distribution list
  ccList String? // JSON array of names/parties CC'd

  // Actionable workflow
  actionAssignedTo String?
  replyDraftedBy   String?
  replyDueDate     DateTime?
  replyStatus      String    @default("not_started") // not_started | in_progress | drafted | sent | closed
  replySentDate    DateTime?
  replyOurRef      String?
  replyNotes       String?

  // EOT-specific fields (when letterType = eot_claim)
  eotDaysClaimed Decimal? @db.Decimal(15, 2) // days of extension requested
  eotDaysGranted Decimal? @db.Decimal(15, 2) // days approved by client/consultant
  eotStatus        String? // submitted | under_review | approved | rejected | partially_approved
  eotLinkedTaskIds String? // JSON array of Gantt task IDs affected

  // Letter file
  fileData String?
  fileName String?
  fileType String?

  // Reply file
  replyFileData String?
  replyFileName String?
  replyFileType String?

  // Cross-references
  linkedRfiId       String?
  linkedBoqItemId   String?
  linkedGanttTaskId String?

  // Audit
  statusHistory String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, direction])
  @@index([projectId, replyStatus])
  @@index([projectId, category])
  @@index([projectId, letterType])
  @@index([replyDueDate])
  @@index([repliesToId])
}

// ─────────────────────────────────────────────────────────────
// Drawing Markup — annotations overlaid on drawings
// ─────────────────────────────────────────────────────────────

model DrawingMarkup {
  id              String   @id @default(cuid())
  drawingId       String
  revisionId      String? // specific revision (null = applies to all)
  type            String // cloud | arrow | text | pin | highlight | measurement | freehand | callout | stamp | area
  x Decimal @db.Decimal(15, 2) // 0-1 percentage of width
  y Decimal @db.Decimal(15, 2) // 0-1 percentage of height
  w Decimal? @db.Decimal(15, 2) // width (for rectangles/clouds, 0-1)
  h Decimal? @db.Decimal(15, 2) // height
  x2 Decimal? @db.Decimal(15, 2) // end point x for lines/arrows/callouts (0-1)
  y2 Decimal? @db.Decimal(15, 2) // end point y
  rotation Decimal? @db.Decimal(15, 2) // degrees
  color           String   @default("#ef4444")
  strokeWidth Decimal? @db.Decimal(15, 4) @default(2)
  opacity Decimal? @db.Decimal(15, 2) @default(1)
  text            String? // for text annotations, callout text, stamp text
  points          String? // JSON array of {x,y} for freehand/area polygons
  stampType       String? // approved | rejected | revision | draft | final | caution
  linkedItemId    String? // link to RFI, punch item, etc.
  linkedItemType  String? // rfi | punch | observation
  percentComplete Decimal? @db.Decimal(15, 4) // 0-100, for "staged" type markups
  createdById     String?
  createdAt       DateTime @default(now())

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@index([drawingId])
  @@index([revisionId])
}

// ─────────────────────────────────────────────────────────────
// Drawing Sets — group drawings into sets (Architectural, Structural, etc.)
// ─────────────────────────────────────────────────────────────

model DrawingSet {
  id          String   @id @default(cuid())
  projectId   String
  name        String // e.g. "Architectural Set", "Structural Set"
  description String?
  createdAt   DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawings Drawing[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Submittals — shop drawings, material samples, product data
// submitted to consultant/client for approval
// ─────────────────────────────────────────────────────────────

model Submittal {
  id             String    @id @default(cuid())
  projectId      String
  number         String // e.g. SUB-001
  title          String
  description    String?
  type           String    @default("shop_drawing") // shop_drawing | material_sample | product_data | technical_spec | other
  category       String? // civil | structural | electrical | mechanical | architectural
  status         String    @default("draft") // draft | submitted | approved | rejected | revise_resubmit
  submittedDate  DateTime?
  reviewedDate   DateTime?
  reviewedBy     String?
  reviewComments String?
  scheduledDate  DateTime? // planned submission date
  dueDate        DateTime? // consultant review deadline

  // Links
  linkedBoqItemId   String?
  linkedGanttTaskId String?
  linkedDrawingId   String?

  // File
  fileData String?
  fileName String?
  fileType String?

  // Returned file (consultant's marked-up copy)
  returnedFileData String?
  returnedFileName String?
  returnedFileType String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, type])
}

// ─────────────────────────────────────────────────────────────
// Punch List — defect tracking for handover
// ─────────────────────────────────────────────────────────────

model PunchItem {
  id          String    @id @default(cuid())
  projectId   String
  number      String // e.g. PL-001
  title       String
  description String
  location    String? // chainage, grid, area
  category    String? // civil | structural | electrical | mechanical | finishing | other
  severity    String    @default("minor") // minor | major | critical
  status      String    @default("open") // open | in_progress | resolved | verified | closed
  assignedTo  String? // responsible person
  dueDate     DateTime?

  // Links
  linkedBoqItemId   String?
  linkedGanttTaskId String?
  linkedDrawingId   String?

  // Drawing/Markup pin links
  drawingId  String?
  revisionId String?
  markupId   String? // link to the markup that marks this defect on a drawing

  // Photo evidence
  photoData String?
  photoName String?
  photoType String?

  // Resolution
  resolvedDate  DateTime?
  resolvedBy    String?
  resolvedNotes String?
  verifiedDate  DateTime?
  verifiedBy    String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawing Drawing? @relation(fields: [drawingId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([drawingId])
  @@index([markupId])
}

// ─────────────────────────────────────────────────────────────
// Communication — chat channels and messages
// ─────────────────────────────────────────────────────────────

model ChatChannel {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  type        String   @default("group") // public | group | personal | project_order | org_order
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members      ChatMember[]
  messages     ChatMessage[]
  readReceipts ChatReadReceipt[]

  @@index([projectId, type])
}

model ChatMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  user      User     @relation("ChatMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // admin | member (admin can add/remove)
  joinedAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id               String   @id @default(cuid())
  channelId        String
  userId           String
  user             User     @relation("ChatMessageUser", fields: [userId], references: [id], onDelete: Cascade)
  text             String
  mentionedUserIds String? // JSON array of user IDs mentioned with @
  attachmentData   String?
  attachmentName   String?
  attachmentType   String?
  linkedEntityType String? // rfi | ipc | drawing | report | boq
  linkedEntityId   String?
  isPinned         Boolean  @default(false)
  createdAt        DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model ChatReadReceipt {
  id                String   @id @default(cuid())
  channelId         String
  userId            String
  user              User     @relation("ChatReadReceiptUser", fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessageId String?
  lastReadAt        DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

// ─────────────────────────────────────────────────────────────
// Payment Tracking — vendor/subcontractor/IPC payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id                  String    @id @default(cuid())
  projectId           String
  payeeType           String // vendor | subcontractor | supplier | staff | other
  payeeId             String? // linked entity ID (subcontractorId, vendorId, etc.)
  payeeName           String
  partyPan            String? // PAN of the payee for Tally / Swastik accounting
  ipcId               String? // linked IPC (if payment is for an IPC)
  invoiceNumber       String?
  amount Decimal @db.Decimal(15, 2)
  tdsDeducted Decimal @db.Decimal(15, 2) @default(0)
  vatIncluded Decimal @db.Decimal(15, 2) @default(0)
  netPaid Decimal @db.Decimal(15, 2) @default(0)
  paymentDate         DateTime  @default(now())
  paymentMiti         String? // Bikram Sambat Miti (e.g. 2081/05/07)
  paymentMode         String    @default("bank_transfer") // cash | bank_transfer | cheque | mobile_pay | connectips
  chequeNo            String?
  bankRef             String?
  bankAccount         String? // e.g. "Nabil Bank A/C", "Global IME", "Site Petty Cash"
  status              String    @default("paid") // pending | paid | cancelled
  retentionReleased Decimal @db.Decimal(15, 2) @default(0)
  notes               String?
  createdById         String?
  createdAt           DateTime  @default(now())

  // Accounting Software (Tally / Swastik) & Category Structure
  categoryId          String?
  subCategoryId       String?
  category            String? // Denormalized Category name (e.g. "Site Overhead")
  subCategory         String? // Denormalized Subcategory name (e.g. "Food & Mess")
  allocationType      String    @default("specific_payee") // specific_payee | bulk_category | advance
  accountingSoftware  String? // "tally" | "swastik" | "other"
  accountingVoucherNo String? // Tally / Swastik Voucher No (e.g. PV-2081-004, BP-012, CP-001)
  voucherType         String?   @default("payment") // payment | bank_payment | cash_payment | journal

  // Scanned Document Attachment
  scannedBillUrl      String?
  scannedBillName     String?
  isBillAttached      Boolean   @default(false)

  // Organization-level Central Bank Account Link
  companyBankAccountId String?
  companyBankAccount   CompanyBankAccount? @relation(fields: [companyBankAccountId], references: [id], onDelete: SetNull)

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paymentCategory PaymentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([projectId, payeeType])
  @@index([projectId, paymentDate])
  @@index([projectId, category])
  @@index([ipcId])
}

model PaymentCategory {
  id          String   @id @default(cuid())
  projectId   String
  name        String // e.g. "Site Overhead", "Material", "Equipment"
  nameNp      String? // Devanagari translation e.g. "साइट ओभरहेड"
  code        String? // e.g. "OVH", "MAT", "EQP" or Swastik Sub-Ledger Code
  color       String?  @default("amber") // theme palette key
  icon        String? // Lucide icon name
  parentId    String? // null = top-level category; set = subcategory
  isSystem    Boolean  @default(false) // built-in preset vs user created
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      PaymentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    PaymentCategory[] @relation("CategoryHierarchy")
  payments    Payment[]

  @@unique([projectId, name, parentId])
  @@index([projectId, parentId])
}

// ─────────────────────────────────────────────────────────────
// Safety Management — incidents, toolbox talks, near-miss
// ─────────────────────────────────────────────────────────────

model SafetyIncident {
  id               String   @id @default(cuid())
  projectId        String
  date             DateTime @default(now())
  type             String   @default("incident") // incident | near_miss | toolbox_talk | observation
  severity         String   @default("minor") // minor | moderate | serious | fatal
  title            String
  description      String
  location         String?
  reportedBy       String?
  involvedPersons  String?
  actionTaken      String?
  rootCause        String?
  preventiveAction String?
  status           String   @default("reported") // reported | investigating | resolved | closed
  photoData        String?
  photoName        String?
  photoType        String?
  toolboxTopic     String? // for toolbox_talk type
  toolboxAttendees String? // JSON array of names
  createdById      String?
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type])
  @@index([projectId, status])
  @@index([projectId, date])
}

// ─────────────────────────────────────────────────────────────
// Quality Inspection — formal inspection workflow
// ─────────────────────────────────────────────────────────────

model QualityInspection {
  id             String    @id @default(cuid())
  projectId      String
  number         String // e.g. QI-001
  title          String
  inspectionType String    @default("work_inspection") // work_inspection | material_test | ncr | site_audit
  status         String    @default("requested") // requested | scheduled | completed | approved | rejected | ncr_raised
  requestedDate  DateTime  @default(now())
  scheduledDate  DateTime?
  inspectedDate  DateTime?
  inspectedBy    String?
  location       String?
  boqItemId      String?
  ganttTaskId    String?
  checklist      String? // JSON: [{item, passed, notes}]
  result         String? // pass | fail | conditional_pass
  remarks        String?
  ncrNumber      String? // if NCR raised
  photoData      String?
  photoName      String?
  photoType      String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([projectId, inspectionType])
}

// ─────────────────────────────────────────────────────────────
// Meeting Minutes — scheduling + action items
// ─────────────────────────────────────────────────────────────

model Meeting {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  type        String   @default("site_coordination") // site_coordination | progress_review | design_coordination | safety | other
  date        DateTime @default(now())
  location    String?
  attendees   String? // JSON array of {name, role, organization}
  agenda      String?
  minutes     String?
  status      String   @default("scheduled") // scheduled | completed | cancelled
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]

  @@index([projectId, date])
  @@index([projectId, status])
}

model MeetingActionItem {
  id            String    @id @default(cuid())
  meetingId     String
  description   String
  assignedTo    String
  dueDate       DateTime?
  status        String    @default("open") // open | in_progress | completed
  completedDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([status])
}

model PurchaseRequisition {
  id              String   @id @default(cuid())
  projectId       String
  number          String // e.g. PR-001
  status          String   @default("draft") // draft | pending_approval | approved | rejected | ordered
  remarks         String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  createdById     String
  approvedById    String?

  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation("RequisitionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy     User?                     @relation("RequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]           @relation("RequisitionPurchaseOrders")

  @@unique([projectId, number])
  @@index([projectId])
}

model PurchaseRequisitionItem {
  id            String @id @default(cuid())
  requisitionId String
  materialId    String
  quantity Decimal @db.Decimal(15, 4)
  unit          String

  // Selection details
  selectedPartnerId String
  justification     String?
  fileUrl           String?

  requisition PurchaseRequisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  material    Material               @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quotes      RequisitionItemQuote[]
  poItems     PurchaseOrderItem[]

  @@index([requisitionId])
}

model RequisitionItemQuote {
  id                String  @id @default(cuid())
  requisitionItemId String
  partnerId         String
  exFactoryRate Decimal @db.Decimal(15, 4)
  transportRate Decimal @db.Decimal(15, 4)
  notes             String?

  requisitionItem PurchaseRequisitionItem @relation(fields: [requisitionItemId], references: [id], onDelete: Cascade)
  partner         Partner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([requisitionItemId])
}

// ─────────────────────────────────────────────────────────────
// Store Locations & Sub-Store Inventory
// ─────────────────────────────────────────────────────────────

model StoreLocation {
  id        String   @id @default(cuid())
  projectId String
  name      String // e.g. "Main Yard Store", "Batching Plant", "Camp 1", "Crusher Site"
  code      String? // e.g. "ST-MAIN", "ST-BP"
  isDefault Boolean  @default(false)
  address   String?
  incharge  String?
  phone     String?
  status    String   @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stocks          MaterialStoreStock[]
  transactions                    MaterialTransaction[] @relation("SourceStoreTransactions")
  targetTransfers                 MaterialTransaction[] @relation("TargetStoreTransactions")
  originInterSiteTransfers        InterSiteTransfer[]   @relation("OriginStoreInterSiteTransfers")
  destinationInterSiteTransfers   InterSiteTransfer[]   @relation("DestinationStoreInterSiteTransfers")

  @@unique([projectId, name])
  @@index([projectId])
}

model MaterialStoreStock {
  id              String   @id @default(cuid())
  materialId      String
  storeLocationId String
  currentStock Decimal @db.Decimal(15, 2) @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  material      Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  storeLocation StoreLocation @relation(fields: [storeLocationId], references: [id], onDelete: Cascade)

  @@unique([materialId, storeLocationId])
  @@index([materialId])
  @@index([storeLocationId])
}

// ─────────────────────────────────────────────────────────────
// 3-Way Matching & Accounts Payable (Vendor Bills & Payments)
// ─────────────────────────────────────────────────────────────

model VendorBill {
  id              String    @id @default(cuid())
  projectId       String
  partnerId       String
  purchaseOrderId String?
  billNumber      String // Supplier's Invoice/Bill No
  billDate        DateTime  @default(now())
  dueDate         DateTime?
  grossAmount Decimal @db.Decimal(15, 2) @default(0)
  vatAmount Decimal @db.Decimal(15, 2) @default(0)
  tdsAmount Decimal @db.Decimal(15, 2) @default(0)
  netPayable Decimal @db.Decimal(15, 2) @default(0)
  paidAmount Decimal @db.Decimal(15, 2) @default(0)
  status          String    @default("unpaid") // unpaid | partially_paid | paid | disputed
  billedToEntity  String    @default("primary_org") // primary_org | dedicated_jv | lead_partner
  recipientPan    String?
  fileUrl         String? // Bill attachment URL/Data
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner       Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  payments      VendorPayment[]
  spotHires     EquipmentSpotHire[]

  @@unique([projectId, partnerId, billNumber])
  @@index([projectId, status])
  @@index([partnerId])
  @@index([purchaseOrderId])
}

model VendorPayment {
  id              String   @id @default(cuid())
  projectId       String
  vendorBillId    String
  amount Decimal @db.Decimal(15, 2)
  paymentDate     DateTime @default(now())
  paymentMethod   String   @default("bank_transfer") // bank_transfer | cheque | cash
  referenceNumber String? // Cheque / Bank Txn Ref
  remarks         String?
  createdById     String?
  createdAt       DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([vendorBillId])
