// ─── Unified Catalog System (v2) ──────────────────────────────────────────────
// Replaces: GlobalMaterialCatalog, MaterialCatalog, OrgMaterialEntry
//           RateCatalogItem, RateCatalogItemRate, OrgRateOverride, ProjectRateOverride

model CatalogMaterial {
  id               String  @id @default(cuid())
  scope            String // "global" | "org" | "project"
  resourceType     String  @default("material") // "material" | "labor" | "equipment"
  organizationId   String? // null for global
  projectId        String? // null for global/org
  sourceMaterialId String? // tracks import origin (CatalogMaterial.id)

  name           String
  normalizedName String
  code           String?
  category       String?
  subCategory    String?
  defaultUnit    String   @default("")
  defaultRate Decimal @db.Decimal(15, 4) @default(0)
  aliases        String[] // search aliases
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rateEntries             RateEntry[]
  substitutes             MaterialSubstitute[]     @relation("MaterialSubstitutes")
  substitutedBy           MaterialSubstitute[]     @relation("SubstituteFor")
  sourceMaterial          CatalogMaterial?         @relation("CatalogMaterialImport", fields: [sourceMaterialId], references: [id], onDelete: SetNull)
  importedBy              CatalogMaterial[]        @relation("CatalogMaterialImport")
  boqIngredients          BoqIngredient[]
  globalPresetIngredients GlobalPresetIngredient[]
  rateProfileItems        RateProfileItem[]
  partnerSupplies         PartnerSupply[]
  materials               Material[]
  materialTransactions    MaterialTransaction[]

  @@unique([normalizedName, organizationId, projectId])
  @@index([scope, organizationId])
  @@index([scope, projectId])
  @@index([normalizedName])
}

model RateEntry {
  id                String  @id @default(cuid())
  materialId        String
  rateCatalogId     String
  district          String
  rate Decimal @db.Decimal(15, 4) @default(0)
  sourceRateEntryId String? // tracks import origin (RateEntry.id)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  material        CatalogMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  rateBook        RateBook        @relation("RateBookEntries", fields: [rateCatalogId], references: [id], onDelete: Cascade, map: "CatalogRate_rateCatalogId_fkey")
  sourceRateEntry RateEntry?      @relation("RateEntryImport", fields: [sourceRateEntryId], references: [id], onDelete: SetNull, map: "CatalogRate_sourceRateEntryId_fkey")
  importedBy      RateEntry[]     @relation("RateEntryImport")

  @@unique([materialId, rateCatalogId, district], map: "CatalogRate_materialId_rateCatalogId_district_key")
  @@index([rateCatalogId], map: "CatalogRate_rateCatalogId_idx")
  @@index([district], map: "CatalogRate_district_idx")
  @@map("CatalogRate")
}

model MaterialSubstitute {
  id           String  @id @default(cuid())
  materialId   String
  substituteId String // another CatalogMaterial.id
  priority     Int     @default(0) // 1 = preferred substitute
  reason       String? // e.g., "not available in district"

  material   CatalogMaterial @relation("MaterialSubstitutes", fields: [materialId], references: [id], onDelete: Cascade)
  substitute CatalogMaterial @relation("SubstituteFor", fields: [substituteId], references: [id], onDelete: Cascade)

  @@unique([materialId, substituteId])
}

